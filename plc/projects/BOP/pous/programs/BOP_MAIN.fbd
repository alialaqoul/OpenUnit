(* BOP - Balance of Plant / Turbine Auxiliaries
   Circulating water, condenser vacuum, condensate pumps, lube oil / jacking oil / turning
   gear, gland steam, vacuum breaker, hotwell level (condenser make-up).
   Naming: I_* field inputs, Q_* field outputs, P_<PEER>_* peer status, IO_* bridge signals;
   all other located variables are this controller's own Modbus registers (HMI faceplates). *)
PROGRAM BOP_MAIN
  VAR
    (* Register map of BOP (generated by scripts/plc-build.js - do not edit here) *)
    HEARTBEAT AT %MD0 : DINT; (* Controller heartbeat counter - status *)
    SCAN_MS AT %MD1 : REAL; (* Logic execution time [ms] - status *)
    SIM_DT AT %MD2 : REAL; (* Simulation time step of last scan [s] - status *)
    IC_APPLIED AT %MD3 : DINT; (* Last applied initial condition - status *)
    SCAN_COUNT AT %MD4 : UDINT; (* Scan counter - status *)
    HEALTHY AT %QX0.0 : BOOL; (* Controller healthy - status *)
    COMM_PLANT AT %QX0.1 : BOOL; (* Communication with field I/O - status *)
    COMM_DEH AT %QX0.2 : BOOL; (* Communication with DEH - status *)
    CWP_A_START AT %QX0.3 : BOOL; (* CW pump A - start command - operator *)
    CWP_A_STOP AT %QX0.4 : BOOL; (* CW pump A - stop command - operator *)
    CWP_A_MODE AT %MD5 : DINT; (* CW pump A - mode - operator *)
    CWP_A_RUN AT %QX0.5 : BOOL; (* CW pump A - running - status *)
    CWP_A_TRIP AT %QX0.6 : BOOL; (* CW pump A - tripped - status *)
    CWP_A_PERM AT %QX0.7 : BOOL; (* CW pump A - start permissive - status *)
    CWP_A_ILK AT %QX1.0 : BOOL; (* CW pump A - protective interlock active - status *)
    CWP_B_START AT %QX1.1 : BOOL; (* CW pump B - start command - operator *)
    CWP_B_STOP AT %QX1.2 : BOOL; (* CW pump B - stop command - operator *)
    CWP_B_MODE AT %MD6 : DINT; (* CW pump B - mode - operator *)
    CWP_B_RUN AT %QX1.3 : BOOL; (* CW pump B - running - status *)
    CWP_B_TRIP AT %QX1.4 : BOOL; (* CW pump B - tripped - status *)
    CWP_B_PERM AT %QX1.5 : BOOL; (* CW pump B - start permissive - status *)
    CWP_B_ILK AT %QX1.6 : BOOL; (* CW pump B - protective interlock active - status *)
    VP_A_START AT %QX1.7 : BOOL; (* Vacuum pump A - start command - operator *)
    VP_A_STOP AT %QX2.0 : BOOL; (* Vacuum pump A - stop command - operator *)
    VP_A_MODE AT %MD7 : DINT; (* Vacuum pump A - mode - operator *)
    VP_A_RUN AT %QX2.1 : BOOL; (* Vacuum pump A - running - status *)
    VP_A_TRIP AT %QX2.2 : BOOL; (* Vacuum pump A - tripped - status *)
    VP_A_PERM AT %QX2.3 : BOOL; (* Vacuum pump A - start permissive - status *)
    VP_A_ILK AT %QX2.4 : BOOL; (* Vacuum pump A - protective interlock active - status *)
    VP_B_START AT %QX2.5 : BOOL; (* Vacuum pump B - start command - operator *)
    VP_B_STOP AT %QX2.6 : BOOL; (* Vacuum pump B - stop command - operator *)
    VP_B_MODE AT %MD8 : DINT; (* Vacuum pump B - mode - operator *)
    VP_B_RUN AT %QX2.7 : BOOL; (* Vacuum pump B - running - status *)
    VP_B_TRIP AT %QX3.0 : BOOL; (* Vacuum pump B - tripped - status *)
    VP_B_PERM AT %QX3.1 : BOOL; (* Vacuum pump B - start permissive - status *)
    VP_B_ILK AT %QX3.2 : BOOL; (* Vacuum pump B - protective interlock active - status *)
    CEP_A_START AT %QX3.3 : BOOL; (* Condensate pump A - start command - operator *)
    CEP_A_STOP AT %QX3.4 : BOOL; (* Condensate pump A - stop command - operator *)
    CEP_A_MODE AT %MD9 : DINT; (* Condensate pump A - mode - operator *)
    CEP_A_RUN AT %QX3.5 : BOOL; (* Condensate pump A - running - status *)
    CEP_A_TRIP AT %QX3.6 : BOOL; (* Condensate pump A - tripped - status *)
    CEP_A_PERM AT %QX3.7 : BOOL; (* Condensate pump A - start permissive - status *)
    CEP_A_ILK AT %QX4.0 : BOOL; (* Condensate pump A - protective interlock active - status *)
    CEP_B_START AT %QX4.1 : BOOL; (* Condensate pump B - start command - operator *)
    CEP_B_STOP AT %QX4.2 : BOOL; (* Condensate pump B - stop command - operator *)
    CEP_B_MODE AT %MD10 : DINT; (* Condensate pump B - mode - operator *)
    CEP_B_RUN AT %QX4.3 : BOOL; (* Condensate pump B - running - status *)
    CEP_B_TRIP AT %QX4.4 : BOOL; (* Condensate pump B - tripped - status *)
    CEP_B_PERM AT %QX4.5 : BOOL; (* Condensate pump B - start permissive - status *)
    CEP_B_ILK AT %QX4.6 : BOOL; (* Condensate pump B - protective interlock active - status *)
    AOP_START AT %QX4.7 : BOOL; (* AC lube oil pump - start command - operator *)
    AOP_STOP AT %QX5.0 : BOOL; (* AC lube oil pump - stop command - operator *)
    AOP_MODE AT %MD11 : DINT; (* AC lube oil pump - mode - operator *)
    AOP_RUN AT %QX5.1 : BOOL; (* AC lube oil pump - running - status *)
    AOP_TRIP AT %QX5.2 : BOOL; (* AC lube oil pump - tripped - status *)
    AOP_PERM AT %QX5.3 : BOOL; (* AC lube oil pump - start permissive - status *)
    AOP_ILK AT %QX5.4 : BOOL; (* AC lube oil pump - protective interlock active - status *)
    EOP_START AT %QX5.5 : BOOL; (* DC emergency oil pump - start command - operator *)
    EOP_STOP AT %QX5.6 : BOOL; (* DC emergency oil pump - stop command - operator *)
    EOP_MODE AT %MD12 : DINT; (* DC emergency oil pump - mode - operator *)
    EOP_RUN AT %QX5.7 : BOOL; (* DC emergency oil pump - running - status *)
    EOP_TRIP AT %QX6.0 : BOOL; (* DC emergency oil pump - tripped - status *)
    EOP_PERM AT %QX6.1 : BOOL; (* DC emergency oil pump - start permissive - status *)
    EOP_ILK AT %QX6.2 : BOOL; (* DC emergency oil pump - protective interlock active - status *)
    JOP_START AT %QX6.3 : BOOL; (* Jacking oil pump - start command - operator *)
    JOP_STOP AT %QX6.4 : BOOL; (* Jacking oil pump - stop command - operator *)
    JOP_MODE AT %MD13 : DINT; (* Jacking oil pump - mode - operator *)
    JOP_RUN AT %QX6.5 : BOOL; (* Jacking oil pump - running - status *)
    JOP_TRIP AT %QX6.6 : BOOL; (* Jacking oil pump - tripped - status *)
    JOP_PERM AT %QX6.7 : BOOL; (* Jacking oil pump - start permissive - status *)
    JOP_ILK AT %QX7.0 : BOOL; (* Jacking oil pump - protective interlock active - status *)
    TG_START AT %QX7.1 : BOOL; (* Turning gear - start command - operator *)
    TG_STOP AT %QX7.2 : BOOL; (* Turning gear - stop command - operator *)
    TG_MODE AT %MD14 : DINT; (* Turning gear - mode - operator *)
    TG_RUN AT %QX7.3 : BOOL; (* Turning gear - running - status *)
    TG_TRIP AT %QX7.4 : BOOL; (* Turning gear - tripped - status *)
    TG_PERM AT %QX7.5 : BOOL; (* Turning gear - start permissive - status *)
    TG_ILK AT %QX7.6 : BOOL; (* Turning gear - protective interlock active - status *)
    GLAND_OPEN AT %QX7.7 : BOOL; (* Gland steam supply - open/close command - operator *)
    GLAND_CLOSE AT %QX8.0 : BOOL; (* Gland steam supply - close/open command - operator *)
    GLAND_MODE AT %MD15 : DINT; (* Gland steam supply - mode - operator *)
    GLAND_OPENED AT %QX8.1 : BOOL; (* Gland steam supply - open - status *)
    GLAND_CLOSED AT %QX8.2 : BOOL; (* Gland steam supply - closed - status *)
    GLAND_PERM AT %QX8.3 : BOOL; (* Gland steam supply - permissive - status *)
    GLAND_ILK AT %QX8.4 : BOOL; (* Gland steam supply - interlock active - status *)
    VB_OPEN AT %QX8.5 : BOOL; (* Vacuum breaker - open/close command - operator *)
    VB_CLOSE AT %QX8.6 : BOOL; (* Vacuum breaker - close/open command - operator *)
    VB_MODE AT %MD16 : DINT; (* Vacuum breaker - mode - operator *)
    VB_OPENED AT %QX8.7 : BOOL; (* Vacuum breaker - open - status *)
    VB_CLOSED AT %QX9.0 : BOOL; (* Vacuum breaker - closed - status *)
    VB_PERM AT %QX9.1 : BOOL; (* Vacuum breaker - permissive - status *)
    VB_ILK AT %QX9.2 : BOOL; (* Vacuum breaker - interlock active - status *)
    HW_DUMP_OPEN AT %QX9.3 : BOOL; (* Hotwell dump valve - open/close command - operator *)
    HW_DUMP_CLOSE AT %QX9.4 : BOOL; (* Hotwell dump valve - close/open command - operator *)
    HW_DUMP_MODE AT %MD17 : DINT; (* Hotwell dump valve - mode - operator *)
    HW_DUMP_OPENED AT %QX9.5 : BOOL; (* Hotwell dump valve - open - status *)
    HW_DUMP_CLOSED AT %QX9.6 : BOOL; (* Hotwell dump valve - closed - status *)
    HW_DUMP_PERM AT %QX9.7 : BOOL; (* Hotwell dump valve - permissive - status *)
    HW_DUMP_ILK AT %QX10.0 : BOOL; (* Hotwell dump valve - interlock active - status *)
    LIC_HW_PV AT %MD18 : REAL; (* Hotwell level control (make-up) - process value [mm] - status *)
    LIC_HW_SP AT %MD19 : REAL; (* Hotwell level control (make-up) - setpoint [mm] - operator *)
    LIC_HW_OUT AT %MD20 : REAL; (* Hotwell level control (make-up) - output [%] - operator *)
    LIC_HW_MODE AT %MD21 : DINT; (* Hotwell level control (make-up) - mode - operator *)
    LIC_HW_KP AT %MD22 : REAL; (* Hotwell level control (make-up) - proportional gain - operator *)
    LIC_HW_TI AT %MD23 : REAL; (* Hotwell level control (make-up) - integral time [s] - operator *)
    LIC_HW_TD AT %MD24 : REAL; (* Hotwell level control (make-up) - derivative time [s] - operator *)
    LIC_HW_CSP AT %MD25 : REAL; (* Hotwell level control (make-up) - cascade/remote setpoint [mm] - status *)
    LIC_HW_STS AT %MD26 : DINT; (* Hotwell level control (make-up) - status bits - status *)
    VAC_OK AT %QX10.1 : BOOL; (* Condenser vacuum established (< 200 mbar) - status *)
    CW_OK AT %QX10.2 : BOOL; (* CW system in service - status *)
    LO_OK AT %QX10.3 : BOOL; (* Lube oil pressure normal - status *)
    COND_PRESS AT %MD27 : REAL; (* Condenser pressure (selected) [mbar] - status *)
    IO_COMM_PLANT AT %QX10.4 : BOOL; (* Bridge: field I/O link healthy - bridge in *)
    IO_COMM_DEH AT %QX10.5 : BOOL; (* Bridge: DEH link and heartbeat healthy - bridge in *)
    IO_IC_SEQ AT %MD28 : DINT; (* Bridge: initial-condition command sequence - bridge in *)
    IO_IC_ID AT %MD29 : DINT; (* Bridge: initial condition number - bridge in *)
    IO_IC_SNAP AT %QX10.6 : BOOL; (* Bridge: controller values restored from a snapshot - bridge in *)
    I_AOP_RUN AT %QX10.7 : BOOL; (* Field input: AC lube oil pump running - bridge in *)
    I_AOP_TRIP AT %QX11.0 : BOOL; (* Field input: AC lube oil pump tripped - bridge in *)
    I_CEP_A_RUN AT %QX11.1 : BOOL; (* Field input: Condensate pump A running - bridge in *)
    I_CEP_A_TRIP AT %QX11.2 : BOOL; (* Field input: Condensate pump A tripped - bridge in *)
    I_CEP_B_RUN AT %QX11.3 : BOOL; (* Field input: Condensate pump B running - bridge in *)
    I_CEP_B_TRIP AT %QX11.4 : BOOL; (* Field input: Condensate pump B tripped - bridge in *)
    I_CEP_PRESS AT %MD30 : REAL; (* Field input: Condensate pump discharge pressure [bar] - bridge in *)
    I_COND_PRESS AT %MD31 : REAL; (* Field input: Condenser pressure (abs) [mbar] - bridge in *)
    I_CWP_A_RUN AT %QX11.5 : BOOL; (* Field input: CW pump A running - bridge in *)
    I_CWP_A_TRIP AT %QX11.6 : BOOL; (* Field input: CW pump A tripped - bridge in *)
    I_CWP_B_RUN AT %QX11.7 : BOOL; (* Field input: CW pump B running - bridge in *)
    I_CWP_B_TRIP AT %QX12.0 : BOOL; (* Field input: CW pump B tripped - bridge in *)
    I_EOP_RUN AT %QX12.1 : BOOL; (* Field input: DC emergency oil pump running - bridge in *)
    I_EOP_TRIP AT %QX12.2 : BOOL; (* Field input: DC emergency oil pump tripped - bridge in *)
    I_GLAND_ON AT %QX12.3 : BOOL; (* Field input: Gland steam supply in service - bridge in *)
    I_HW_DUMP_OPEN AT %QX12.4 : BOOL; (* Field input: Hotwell dump valve open - bridge in *)
    I_HW_LVL AT %MD32 : REAL; (* Field input: Hotwell level [mm] - bridge in *)
    I_JOP_RUN AT %QX12.5 : BOOL; (* Field input: Jacking oil pump running - bridge in *)
    I_JOP_TRIP AT %QX12.6 : BOOL; (* Field input: Jacking oil pump tripped - bridge in *)
    I_LO_PRESS AT %MD33 : REAL; (* Field input: Lube oil header pressure [bar] - bridge in *)
    I_MAKEUP_FB AT %MD34 : REAL; (* Field input: Condenser make-up valve position [%] - bridge in *)
    I_SIM_TIME_MS AT %MD35 : UDINT; (* Field input: Simulation clock [ms] - bridge in *)
    I_SPEED_A AT %MD36 : REAL; (* Field input: Turbine speed probe A [rpm] - bridge in *)
    I_SPEED_B AT %MD37 : REAL; (* Field input: Turbine speed probe B [rpm] - bridge in *)
    I_SPEED_C AT %MD38 : REAL; (* Field input: Turbine speed probe C [rpm] - bridge in *)
    I_TG_RUN AT %QX12.7 : BOOL; (* Field input: Turning gear motor running - bridge in *)
    I_TG_TRIP AT %QX13.0 : BOOL; (* Field input: Turning gear motor tripped - bridge in *)
    I_VB_OPEN AT %QX13.1 : BOOL; (* Field input: Vacuum breaker open - bridge in *)
    I_VP_A_RUN AT %QX13.2 : BOOL; (* Field input: Vacuum pump A running - bridge in *)
    I_VP_A_TRIP AT %QX13.3 : BOOL; (* Field input: Vacuum pump A tripped - bridge in *)
    I_VP_B_RUN AT %QX13.4 : BOOL; (* Field input: Vacuum pump B running - bridge in *)
    I_VP_B_TRIP AT %QX13.5 : BOOL; (* Field input: Vacuum pump B tripped - bridge in *)
    P_DEH_TRIPPED AT %QX13.6 : BOOL; (* From DEH: Turbine tripped - bridge in *)
    IC_ACK AT %MD39 : DINT; (* Last initial-condition command acknowledged - status *)
    Q_AOP_CMD AT %QX13.7 : BOOL; (* Field output: AOP run command - status *)
    Q_CEP_A_CMD AT %QX14.0 : BOOL; (* Field output: CEP_A run command - status *)
    Q_CEP_B_CMD AT %QX14.1 : BOOL; (* Field output: CEP_B run command - status *)
    Q_CWP_A_CMD AT %QX14.2 : BOOL; (* Field output: CWP_A run command - status *)
    Q_CWP_B_CMD AT %QX14.3 : BOOL; (* Field output: CWP_B run command - status *)
    Q_EOP_CMD AT %QX14.4 : BOOL; (* Field output: EOP run command - status *)
    Q_GLAND_CMD AT %QX14.5 : BOOL; (* Field output: Gland steam supply valve open - status *)
    Q_HW_DUMP_CMD AT %QX14.6 : BOOL; (* Field output: Hotwell dump valve open - status *)
    Q_JOP_CMD AT %QX14.7 : BOOL; (* Field output: JOP run command - status *)
    Q_MAKEUP_DMD AT %MD40 : REAL; (* Field output: Condenser make-up valve demand [%] - status *)
    Q_TG_CMD AT %QX15.0 : BOOL; (* Field output: TG run command - status *)
    Q_VB_CMD AT %QX15.1 : BOOL; (* Field output: Vacuum breaker open - status *)
    Q_VP_A_CMD AT %QX15.2 : BOOL; (* Field output: VP_A run command - status *)
    Q_VP_B_CMD AT %QX15.3 : BOOL; (* Field output: VP_B run command - status *)
  END_VAR
  VAR
    RT : FB_PLC_RUNTIME;
    CWP_A : FB_MOTOR;
    CWP_B : FB_MOTOR;
    VP_A : FB_MOTOR;
    VP_B : FB_MOTOR;
    CEP_A : FB_MOTOR;
    CEP_B : FB_MOTOR;
    AOP : FB_MOTOR;
    EOP : FB_MOTOR;
    JOP : FB_MOTOR;
    TG : FB_MOTOR;
    GLAND : FB_ONOFF;
    VB : FB_ONOFF;
    HW_DUMP : FB_ONOFF;
    LIC_HW : FB_LOOP;
    CEP_LOWP_TMR : FB_TONS;
    dts : REAL;
    init : BOOL;
    speed : REAL;
    condP : REAL;
    loP : REAL;
    hwLvl : REAL;
    vacPoor : BOOL;
    cepPermit : BOOL;
    cepLowP : BOOL;
    tgPermit : BOOL;
    dehTripped : BOOL;
    tripCwpA : BOOL;
    tripCwpB : BOOL;
    tripVpA : BOOL;
    tripVpB : BOOL;
    tripCepA : BOOL;
    tripCepB : BOOL;
  END_VAR
  VAR
    (* branch conditions of the function block diagram *)
    IF2 : BOOL; (* IF IO_IC_ID >= 2 THEN *)
    IF2_ELSE : BOOL; (* ELSE (none of: IO_IC_ID >= 2) *)
    IF4 : BOOL; (* IF IO_COMM_DEH THEN *)
    IF4_ELSE : BOOL; (* ELSE (none of: IO_COMM_DEH) *)
  END_VAR

