(* STC - Steam Temperature Control
   Main steam: cascade TIC_MS (master, sets the desuperheater outlet temperature) ->
   TIC_DSH (slave, SH spray valve), with a superheat margin above saturation.
   Reheat: burner tilt TIC_RH is the primary control, TIC_RHS spray is a high-limit backstop.
   Naming: I_* field inputs, Q_* field outputs, P_<PEER>_* peer status, IO_* bridge signals. *)
PROGRAM STC_MAIN
  VAR
    (* Register map of STC (generated by scripts/plc-build.js - do not edit here) *)
    HEARTBEAT AT %MD0 : DINT; (* Controller heartbeat counter - status *)
    SCAN_MS AT %MD1 : REAL; (* Logic execution time [ms] - status *)
    SIM_DT AT %MD2 : REAL; (* Simulation time step of last scan [s] - status *)
    IC_APPLIED AT %MD3 : DINT; (* Last applied initial condition - status *)
    SCAN_COUNT AT %MD4 : UDINT; (* Scan counter - status *)
    HEALTHY AT %QX0.0 : BOOL; (* Controller healthy - status *)
    COMM_PLANT AT %QX0.1 : BOOL; (* Communication with field I/O - status *)
    COMM_BMS AT %QX0.2 : BOOL; (* Communication with BMS - status *)
    COMM_DEH AT %QX0.3 : BOOL; (* Communication with DEH - status *)
    COMM_CCS AT %QX0.4 : BOOL; (* Communication with CCS - status *)
    SPRAY_BLOCK_OPEN AT %QX0.5 : BOOL; (* SH spray block valve - open/close command - operator *)
    SPRAY_BLOCK_CLOSE AT %QX0.6 : BOOL; (* SH spray block valve - close/open command - operator *)
    SPRAY_BLOCK_MODE AT %MD5 : DINT; (* SH spray block valve - mode - operator *)
    SPRAY_BLOCK_OPENED AT %QX0.7 : BOOL; (* SH spray block valve - open - status *)
    SPRAY_BLOCK_CLOSED AT %QX1.0 : BOOL; (* SH spray block valve - closed - status *)
    SPRAY_BLOCK_PERM AT %QX1.1 : BOOL; (* SH spray block valve - permissive - status *)
    SPRAY_BLOCK_ILK AT %QX1.2 : BOOL; (* SH spray block valve - interlock active - status *)
    TIC_MS_PV AT %MD6 : REAL; (* Main steam temperature (master) - process value [degC] - status *)
    TIC_MS_SP AT %MD7 : REAL; (* Main steam temperature (master) - setpoint [degC] - operator *)
    TIC_MS_OUT AT %MD8 : REAL; (* Main steam temperature (master) - output [degC] - operator *)
    TIC_MS_MODE AT %MD9 : DINT; (* Main steam temperature (master) - mode - operator *)
    TIC_MS_KP AT %MD10 : REAL; (* Main steam temperature (master) - proportional gain - operator *)
    TIC_MS_TI AT %MD11 : REAL; (* Main steam temperature (master) - integral time [s] - operator *)
    TIC_MS_TD AT %MD12 : REAL; (* Main steam temperature (master) - derivative time [s] - operator *)
    TIC_MS_CSP AT %MD13 : REAL; (* Main steam temperature (master) - cascade/remote setpoint [degC] - status *)
    TIC_MS_STS AT %MD14 : DINT; (* Main steam temperature (master) - status bits - status *)
    TIC_DSH_PV AT %MD15 : REAL; (* Desuperheater outlet temperature (SH spray) - process value [degC] - status *)
    TIC_DSH_SP AT %MD16 : REAL; (* Desuperheater outlet temperature (SH spray) - setpoint [degC] - operator *)
    TIC_DSH_OUT AT %MD17 : REAL; (* Desuperheater outlet temperature (SH spray) - output [%] - operator *)
    TIC_DSH_MODE AT %MD18 : DINT; (* Desuperheater outlet temperature (SH spray) - mode - operator *)
    TIC_DSH_KP AT %MD19 : REAL; (* Desuperheater outlet temperature (SH spray) - proportional gain - operator *)
    TIC_DSH_TI AT %MD20 : REAL; (* Desuperheater outlet temperature (SH spray) - integral time [s] - operator *)
    TIC_DSH_TD AT %MD21 : REAL; (* Desuperheater outlet temperature (SH spray) - derivative time [s] - operator *)
    TIC_DSH_CSP AT %MD22 : REAL; (* Desuperheater outlet temperature (SH spray) - cascade/remote setpoint [degC] - status *)
    TIC_DSH_STS AT %MD23 : DINT; (* Desuperheater outlet temperature (SH spray) - status bits - status *)
    TIC_RH_PV AT %MD24 : REAL; (* Reheat temperature (burner tilt) - process value [degC] - status *)
    TIC_RH_SP AT %MD25 : REAL; (* Reheat temperature (burner tilt) - setpoint [degC] - operator *)
    TIC_RH_OUT AT %MD26 : REAL; (* Reheat temperature (burner tilt) - output [deg] - operator *)
    TIC_RH_MODE AT %MD27 : DINT; (* Reheat temperature (burner tilt) - mode - operator *)
    TIC_RH_KP AT %MD28 : REAL; (* Reheat temperature (burner tilt) - proportional gain - operator *)
    TIC_RH_TI AT %MD29 : REAL; (* Reheat temperature (burner tilt) - integral time [s] - operator *)
    TIC_RH_TD AT %MD30 : REAL; (* Reheat temperature (burner tilt) - derivative time [s] - operator *)
    TIC_RH_CSP AT %MD31 : REAL; (* Reheat temperature (burner tilt) - cascade/remote setpoint [degC] - status *)
    TIC_RH_STS AT %MD32 : DINT; (* Reheat temperature (burner tilt) - status bits - status *)
    TIC_RHS_PV AT %MD33 : REAL; (* Reheat emergency spray - process value [degC] - status *)
    TIC_RHS_SP AT %MD34 : REAL; (* Reheat emergency spray - setpoint [degC] - operator *)
    TIC_RHS_OUT AT %MD35 : REAL; (* Reheat emergency spray - output [%] - operator *)
    TIC_RHS_MODE AT %MD36 : DINT; (* Reheat emergency spray - mode - operator *)
    TIC_RHS_KP AT %MD37 : REAL; (* Reheat emergency spray - proportional gain - operator *)
    TIC_RHS_TI AT %MD38 : REAL; (* Reheat emergency spray - integral time [s] - operator *)
    TIC_RHS_TD AT %MD39 : REAL; (* Reheat emergency spray - derivative time [s] - operator *)
    TIC_RHS_CSP AT %MD40 : REAL; (* Reheat emergency spray - cascade/remote setpoint [degC] - status *)
    TIC_RHS_STS AT %MD41 : DINT; (* Reheat emergency spray - status bits - status *)
    RHS_OFFSET AT %MD42 : REAL; (* RH spray setpoint offset above RH SP [degC] - operator *)
    DSH_SP_MIN AT %MD43 : REAL; (* Minimum DSH outlet setpoint (superheat margin) [degC] - status *)
    MS_SUPERHEAT AT %MD44 : REAL; (* Main steam superheat [K] - status *)
    SPRAY_PERMIT AT %QX1.3 : BOOL; (* SH spray permitted (load > 20 %) - status *)
    CCS_HB AT %MD45 : DINT; (* CCS heartbeat (peer write) - written by CCS *)
    BLR_DMD_FF AT %MD46 : REAL; (* Boiler demand feed-forward from CCS [%] - written by CCS *)
    IO_COMM_PLANT AT %QX1.4 : BOOL; (* Bridge: field I/O link healthy - bridge in *)
    IO_COMM_BMS AT %QX1.5 : BOOL; (* Bridge: BMS link and heartbeat healthy - bridge in *)
    IO_COMM_DEH AT %QX1.6 : BOOL; (* Bridge: DEH link and heartbeat healthy - bridge in *)
    IO_COMM_CCS AT %QX1.7 : BOOL; (* Bridge: CCS link and heartbeat healthy - bridge in *)
    IO_IC_SEQ AT %MD47 : DINT; (* Bridge: initial-condition command sequence - bridge in *)
    IO_IC_ID AT %MD48 : DINT; (* Bridge: initial condition number - bridge in *)
    IO_IC_SNAP AT %QX2.0 : BOOL; (* Bridge: controller values restored from a snapshot - bridge in *)
    I_DSH_OUT_TEMP AT %MD49 : REAL; (* Field input: Desuperheater outlet temperature [degC] - bridge in *)
    I_HRH_TEMP AT %MD50 : REAL; (* Field input: Hot reheat temperature [degC] - bridge in *)
    I_MS_PRESS AT %MD51 : REAL; (* Field input: Main steam (throttle) pressure [bar] - bridge in *)
    I_MS_TEMP AT %MD52 : REAL; (* Field input: Main steam temperature [degC] - bridge in *)
    I_RH_SPRAY_FB AT %MD53 : REAL; (* Field input: RH spray valve position [%] - bridge in *)
    I_SH_SPRAY_FB AT %MD54 : REAL; (* Field input: SH spray valve position [%] - bridge in *)
    I_SIM_TIME_MS AT %MD55 : UDINT; (* Field input: Simulation clock [ms] - bridge in *)
    I_SPRAY_BLOCK_OPEN AT %QX2.1 : BOOL; (* Field input: SH spray block valve open - bridge in *)
    I_STEAM_FLOW AT %MD56 : REAL; (* Field input: Main steam flow [t/h] - bridge in *)
    I_TILT_FB AT %MD57 : REAL; (* Field input: Burner tilt position [deg] - bridge in *)
    P_BMS_MFT AT %QX2.2 : BOOL; (* From BMS: Master fuel trip active - bridge in *)
    P_DEH_TRIPPED AT %QX2.3 : BOOL; (* From DEH: Turbine tripped - bridge in *)
    IC_ACK AT %MD58 : DINT; (* Last initial-condition command acknowledged - status *)
    Q_RH_SPRAY_DMD AT %MD59 : REAL; (* Field output: RH spray control valve demand [%] - status *)
    Q_SH_SPRAY_DMD AT %MD60 : REAL; (* Field output: SH spray control valve demand [%] - status *)
    Q_SPRAY_BLOCK_CMD AT %QX2.4 : BOOL; (* Field output: SH spray block valve open - status *)
    Q_TILT_DMD AT %MD61 : REAL; (* Field output: Burner tilt demand [deg] - status *)
  END_VAR
  VAR
    RT : FB_PLC_RUNTIME;
    SPRAY_BLOCK : FB_ONOFF;
    TIC_MS : FB_LOOP;
    TIC_DSH : FB_LOOP;
    TIC_RH : FB_LOOP;
    TIC_RHS : FB_LOOP;
    dts : REAL;
    init : BOOL;
    steamPct : REAL;
    mft : BOOL;
    turbTrip : BOOL;
    permit : BOOL;
    permitLatch : BOOL;
    pmsAbs : REAL;
    tSatMs : REAL;
    dshMin : REAL;
    sprayOk : BOOL;
    dshCas : BOOL;
    rhPermit : BOOL;
  END_VAR
  VAR CONSTANT
    MCR_STEAM : REAL := 2149.0;   (* t/h at 100 % *)
  END_VAR
  VAR
    (* branch conditions of the function block diagram *)
    IF3 : BOOL; (* IF IO_IC_ID >= 2 THEN *)
    IF3_ELSE : BOOL; (* ELSE (none of: IO_IC_ID >= 2) *)
    IF5 : BOOL; (* IF IO_COMM_BMS THEN *)
    IF5_ELSE : BOOL; (* ELSE (none of: IO_COMM_BMS) *)
    IF6 : BOOL; (* IF IO_COMM_DEH THEN *)
    IF6_ELSE : BOOL; (* ELSE (none of: IO_COMM_DEH) *)
    IF7 : BOOL; (* IF permitLatch THEN *)
    IF7_ELSE : BOOL; (* ELSE (none of: permitLatch) *)
    IF8 : BOOL; (* IF TIC_RHS_MODE <> 0 THEN *)
  END_VAR

