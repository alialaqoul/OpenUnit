(* CCS - Unit Coordinated Control
   Unit control modes BASE / BOILER FOLLOW / TURBINE FOLLOW / COORDINATED with permissives
   (a mode whose permissive drops degrades automatically), unit load demand with ramp rate,
   GO / HOLD, frequency bias, capMw limit from the burner elevations in service and fan /
   BFP runbacks, sliding or fixed throttle pressure setpoint, boiler master (PIC_TP) with
   load feed-forward and fast cut-back on load rejection.
   Naming: I_* field inputs, P_<PEER>_* peer status, W_<PEER>_* values written into peers
   (CMB boiler demand, DEH load / pressure references, STC feed-forward), IO_* bridge signals. *)
PROGRAM CCS_MAIN
  VAR
    (* Register map of CCS (generated by scripts/plc-build.js - do not edit here) *)
    HEARTBEAT AT %MD0 : DINT; (* Controller heartbeat counter - status *)
    SCAN_MS AT %MD1 : REAL; (* Logic execution time [ms] - status *)
    SIM_DT AT %MD2 : REAL; (* Simulation time step of last scan [s] - status *)
    IC_APPLIED AT %MD3 : DINT; (* Last applied initial condition - status *)
    SCAN_COUNT AT %MD4 : UDINT; (* Scan counter - status *)
    HEALTHY AT %QX0.0 : BOOL; (* Controller healthy - status *)
    COMM_PLANT AT %QX0.1 : BOOL; (* Communication with field I/O - status *)
    COMM_DEH AT %QX0.2 : BOOL; (* Communication with DEH - status *)
    COMM_CMB AT %QX0.3 : BOOL; (* Communication with CMB - status *)
    COMM_FWC AT %QX0.4 : BOOL; (* Communication with FWC - status *)
    COMM_BMS AT %QX0.5 : BOOL; (* Communication with BMS - status *)
    COMM_STC AT %QX0.6 : BOOL; (* Communication with STC - status *)
    MODE_REQ AT %MD5 : DINT; (* Requested unit control mode - operator *)
    ULD_TARGET AT %MD6 : REAL; (* Unit load target [MW] - operator *)
    ULD_RATE AT %MD7 : REAL; (* Unit loading rate [MW/min] - operator *)
    MAX_LOAD AT %MD8 : REAL; (* Maximum load limit [MW] - operator *)
    MIN_LOAD AT %MD9 : REAL; (* Minimum load limit [MW] - operator *)
    PRESS_MODE AT %MD10 : DINT; (* Pressure mode - operator *)
    PRESS_FIXED AT %MD11 : REAL; (* Fixed throttle pressure setpoint [bar] - operator *)
    PRESS_RATE AT %MD12 : REAL; (* Pressure setpoint rate [bar/min] - operator *)
    FREQ_BIAS AT %MD13 : DINT; (* Frequency bias on unit load - operator *)
    GO AT %QX0.7 : BOOL; (* Unit load ramp GO - operator *)
    HOLD AT %QX1.0 : BOOL; (* Unit load ramp HOLD - operator *)
    PIC_TP_PV AT %MD14 : REAL; (* Boiler master (throttle pressure) - process value [bar] - status *)
    PIC_TP_SP AT %MD15 : REAL; (* Boiler master (throttle pressure) - setpoint [bar] - operator *)
    PIC_TP_OUT AT %MD16 : REAL; (* Boiler master (throttle pressure) - output [%] - operator *)
    PIC_TP_MODE AT %MD17 : DINT; (* Boiler master (throttle pressure) - mode - operator *)
    PIC_TP_KP AT %MD18 : REAL; (* Boiler master (throttle pressure) - proportional gain - operator *)
    PIC_TP_TI AT %MD19 : REAL; (* Boiler master (throttle pressure) - integral time [s] - operator *)
    PIC_TP_TD AT %MD20 : REAL; (* Boiler master (throttle pressure) - derivative time [s] - operator *)
    PIC_TP_CSP AT %MD21 : REAL; (* Boiler master (throttle pressure) - cascade/remote setpoint [bar] - status *)
    PIC_TP_STS AT %MD22 : DINT; (* Boiler master (throttle pressure) - status bits - status *)
    MODE_ACT AT %MD23 : DINT; (* Active unit control mode - status *)
    ULD_ACT AT %MD24 : REAL; (* Unit load demand (ramped) [MW] - status *)
    ULD_FREQ AT %MD25 : REAL; (* Unit load demand incl. frequency bias [MW] - status *)
    PRESS_SP AT %MD26 : REAL; (* Throttle pressure setpoint (active) [bar] - status *)
    PRESS_DEV AT %MD27 : REAL; (* Throttle pressure deviation [bar] - status *)
    BLR_DMD AT %MD28 : REAL; (* Boiler demand [%] - status *)
    CAPACITY AT %MD29 : REAL; (* Available unit capacity [MW] - status *)
    RB_TARGET AT %MD30 : REAL; (* Runback target [MW] - status *)
    RB_ACTIVE AT %QX1.1 : BOOL; (* Runback in progress - status *)
    RAMPING AT %QX1.2 : BOOL; (* Load ramp in progress - status *)
    BLOCK_INC AT %QX1.3 : BOOL; (* Load increase blocked - status *)
    BLOCK_DEC AT %QX1.4 : BOOL; (* Load decrease blocked - status *)
    CC_PERM AT %QX1.5 : BOOL; (* Coordinated control permissive - status *)
    BF_PERM AT %QX1.6 : BOOL; (* Boiler follow permissive - status *)
    TF_PERM AT %QX1.7 : BOOL; (* Turbine follow permissive - status *)
    MODE_DROPPED AT %QX2.0 : BOOL; (* Control mode degraded automatically - status *)
    IO_COMM_PLANT AT %QX2.1 : BOOL; (* Bridge: field I/O link healthy - bridge in *)
    IO_COMM_DEH AT %QX2.2 : BOOL; (* Bridge: DEH link and heartbeat healthy - bridge in *)
    IO_COMM_CMB AT %QX2.3 : BOOL; (* Bridge: CMB link and heartbeat healthy - bridge in *)
    IO_COMM_FWC AT %QX2.4 : BOOL; (* Bridge: FWC link and heartbeat healthy - bridge in *)
    IO_COMM_BMS AT %QX2.5 : BOOL; (* Bridge: BMS link and heartbeat healthy - bridge in *)
    IO_COMM_STC AT %QX2.6 : BOOL; (* Bridge: STC link and heartbeat healthy - bridge in *)
    IO_IC_SEQ AT %MD31 : DINT; (* Bridge: initial-condition command sequence - bridge in *)
    IO_IC_ID AT %MD32 : DINT; (* Bridge: initial condition number - bridge in *)
    IO_IC_SNAP AT %QX2.7 : BOOL; (* Bridge: controller values restored from a snapshot - bridge in *)
    I_FUEL_HEAT AT %MD33 : REAL; (* Field input: Fuel heat input [MW] - bridge in *)
    I_GCB_CLOSED AT %QX3.0 : BOOL; (* Field input: Generator circuit breaker (52G) closed - bridge in *)
    I_GEN_MW AT %MD34 : REAL; (* Field input: Generator active power [MW] - bridge in *)
    I_GRID_FREQ AT %MD35 : REAL; (* Field input: Grid frequency [Hz] - bridge in *)
    I_MS_PRESS AT %MD36 : REAL; (* Field input: Main steam (throttle) pressure [bar] - bridge in *)
    I_SIM_TIME_MS AT %MD37 : UDINT; (* Field input: Simulation clock [ms] - bridge in *)
    P_BMS_ELEV_INSERV AT %MD38 : DINT; (* From BMS: Burner elevations in service - bridge in *)
    P_BMS_MFT AT %QX3.1 : BOOL; (* From BMS: Master fuel trip active - bridge in *)
    P_CMB_AIR_AUTO AT %QX3.2 : BOOL; (* From CMB: Air flow control in automatic - bridge in *)
    P_CMB_FM_AUTO AT %QX3.3 : BOOL; (* From CMB: Fuel master in automatic (CAS) - bridge in *)
    P_CMB_FURN_AUTO AT %QX3.4 : BOOL; (* From CMB: Furnace pressure control in automatic - bridge in *)
    P_CMB_RB_FAN AT %QX3.5 : BOOL; (* From CMB: Fan runback request - bridge in *)
    P_DEH_LATCHED AT %QX3.6 : BOOL; (* From DEH: Turbine latched (reset) - bridge in *)
    P_DEH_REM_READY AT %QX3.7 : BOOL; (* From DEH: Ready for CCS remote control - bridge in *)
    P_FWC_LVL_AUTO AT %QX4.0 : BOOL; (* From FWC: Drum level control in automatic - bridge in *)
    P_FWC_RB_BFP AT %QX4.1 : BOOL; (* From FWC: BFP runback request - bridge in *)
    IC_ACK AT %MD39 : DINT; (* Last initial-condition command acknowledged - status *)
    W_CMB_BLR_DMD_REM AT %MD40 : REAL; (* To CMB: Boiler demand from CCS boiler master [%] - status *)
    W_CMB_CCS_BM_AUTO AT %MD41 : DINT; (* To CMB: CCS boiler master in auto - status *)
    W_DEH_CCS_REQ AT %MD42 : DINT; (* To DEH: CCS request - status *)
    W_DEH_LOAD_REF_REM AT %MD43 : REAL; (* To DEH: Load reference from CCS [MW] - status *)
    W_DEH_PRESS_SP_REM AT %MD44 : REAL; (* To DEH: Throttle pressure setpoint from CCS [bar] - status *)
    W_STC_BLR_DMD_FF AT %MD45 : REAL; (* To STC: Boiler demand feed-forward from CCS [%] - status *)
  END_VAR
  VAR
    RT : FB_PLC_RUNTIME;
    PIC_TP : FB_LOOP;
    dts : REAL;
    init : BOOL;
    mw : REAL;
    pms : REAL;
    gcb : BOOL;
    gcbPrev : BOOL;
    gcbOpened : BOOL;
    mft : BOOL;
    elevIn : DINT;
    remReady : BOOL;
    latched : BOOL;
    fmAuto : BOOL;
    airAuto : BOOL;
    furnAuto : BOOL;
    rbFan : BOOL;
    lvlAuto : BOOL;
    rbBfp : BOOL;
    bfPerm : BOOL;
    ccPerm : BOOL;
    tfPerm : BOOL;
    req : DINT;
    active : DINT;
    prevActive : DINT;
    dropT : REAL;
    capMw : REAL;
    rbRate : REAL;
    goLatch : BOOL;
    uld : REAL;
    psp : REAL;
    dev : REAL;
    blockInc : BOOL;
    blockDec : BOOL;
    rbActive : BOOL;
    tgt : REAL;
    lim : REAL;
    stepR : REAL;
    d : REAL;
    df : REAL;
    dfDb : REAL;
    fbias : REAL;
    uldF : REAL;
    loadForP : REAL;
    loadPct : REAL;
    pTarget : REAL;
    pr : REAL;
    bmTrk : BOOL;
    bmTrkVal : REAL;
    ffLoad : REAL;
    cutBack : BOOL;
  END_VAR
  VAR CONSTANT
    RATED : REAL := 700.0;        (* MW *)
    ELEV_MW : REAL := 210.0;      (* unit capability per burner elevation in service *)
    M_BASE : DINT := 0;
    M_BF : DINT := 1;
    M_TF : DINT := 2;
    M_CC : DINT := 3;
  END_VAR
  VAR
    (* branch conditions of the function block diagram *)
    IF3 : BOOL; (* IF mw > 50.0 THEN *)
    IF3_ELSE : BOOL; (* ELSE (none of: mw > 50.0) *)
    IF4 : BOOL; (* IF IO_IC_ID >= 4 THEN *)
    IF4_ELSE : BOOL; (* ELSE (none of: IO_IC_ID >= 4) *)
    IF6 : BOOL; (* IF NOT RT.GRACE THEN *)
    IF7 : BOOL; (* IF req = M_CC AND NOT ccPerm THEN *)
    IF8 : BOOL; (* IF bfPerm THEN *)
    IF8_ELSE : BOOL; (* ELSE (none of: bfPerm) *)
    IF9 : BOOL; (* IF req = M_TF AND NOT tfPerm THEN *)
    IF10 : BOOL; (* IF req = M_BF AND NOT bfPerm THEN *)
    IF11 : BOOL; (* IF active <> req THEN *)
    IF12 : BOOL; (* IF prevActive = req THEN *)
    IF13 : BOOL; (* IF rbFan OR rbBfp THEN *)
    IF14 : BOOL; (* IF rbFan THEN *)
    IF14_ELSE : BOOL; (* ELSE (none of: rbFan) *)
    IF15 : BOOL; (* IF GO THEN *)
    IF16 : BOOL; (* IF HOLD THEN *)
    IF17 : BOOL; (* IF active = M_CC OR active = M_TF THEN *)
    IF17_ELSE : BOOL; (* ELSE (none of: active = M_CC OR active = M_TF) *)
    IF18 : BOOL; (* IF uld > capMw + 1.0 THEN *)
    IF18_2 : BOOL; (* ELSIF goLatch THEN *)
    IF19 : BOOL; (* IF rbRate > 0.0 THEN *)
    IF19_ELSE : BOOL; (* ELSE (none of: rbRate > 0.0) *)
    IF20 : BOOL; (* IF d > 0.0 AND blockInc OR d < 0.0 AND blockDec THEN *)
    IF21 : BOOL; (* IF ABS(lim - uld) < 0.05 THEN *)
    IF22 : BOOL; (* IF df > 0.015 THEN *)
    IF22_2 : BOOL; (* ELSIF df < -0.015 THEN *)
    IF23 : BOOL; (* IF FREQ_BIAS <> 0 AND active = M_CC THEN *)
    IF24 : BOOL; (* IF active = M_CC OR active = M_TF THEN *)
    IF24_ELSE : BOOL; (* ELSE (none of: active = M_CC OR active = M_TF) *)
    IF25 : BOOL; (* IF PRESS_MODE = 1 THEN *)
    IF25_ELSE : BOOL; (* ELSE (none of: PRESS_MODE = 1) *)
    IF26 : BOOL; (* IF loadPct <= 30.0 THEN *)
    IF26_2 : BOOL; (* ELSIF loadPct >= 90.0 THEN *)
    IF26_ELSE : BOOL; (* ELSE (none of: loadPct <= 30.0 / loadPct >= 90.0) *)
    IF27 : BOOL; (* IF active = M_BASE THEN *)
    IF27_2 : BOOL; (* ELSIF NOT RT.RESYNC THEN *)
    IF28 : BOOL; (* IF active = M_BF OR active = M_CC THEN *)
    IF29 : BOOL; (* IF mft THEN *)
    IF29_2 : BOOL; (* ELSIF NOT fmAuto THEN *)
    IF29_3 : BOOL; (* ELSIF active = M_TF THEN *)
    IF30 : BOOL; (* IF active = M_CC THEN *)
    IF30_ELSE : BOOL; (* ELSE (none of: active = M_CC) *)
    IF31 : BOOL; (* IF cutBack THEN *)
    IF32 : BOOL; (* IF active = M_BF OR active = M_CC THEN *)
    IF32_ELSE : BOOL; (* ELSE (none of: active = M_BF OR active = M_CC) *)
    IF33 : BOOL; (* IF active = M_CC THEN *)
    IF33_2 : BOOL; (* ELSIF active = M_TF THEN *)
    IF33_ELSE : BOOL; (* ELSE (none of: active = M_CC / active = M_TF) *)
  END_VAR

