(* FWC - Feedwater & Condensate Control
   Drum level: 1-element (level -> FW valve) at low load, 3-element (level master trims a steam
   flow feed-forward, FW flow slave) above 25 % steam flow, bumpless transfer between them.
   Boiler feed pumps: valve differential pressure master (PIC_FWDP) -> speed stations, standby
   pump auto start on a partner trip (it joins the master demand), runback request if fewer than
   two pumps run above 58 % load.  Deaerator level and pegging steam, blowdown, HP heaters.
   Naming: I_* field inputs, Q_* field outputs, P_<PEER>_* peer status, IO_* bridge signals. *)
PROGRAM FWC_MAIN
  VAR
    (* Register map of FWC (generated by scripts/plc-build.js - do not edit here) *)
    HEARTBEAT AT %MD0 : DINT; (* Controller heartbeat counter - status *)
    SCAN_MS AT %MD1 : REAL; (* Logic execution time [ms] - status *)
    SIM_DT AT %MD2 : REAL; (* Simulation time step of last scan [s] - status *)
    IC_APPLIED AT %MD3 : DINT; (* Last applied initial condition - status *)
    SCAN_COUNT AT %MD4 : UDINT; (* Scan counter - status *)
    HEALTHY AT %QX0.0 : BOOL; (* Controller healthy - status *)
    COMM_PLANT AT %QX0.1 : BOOL; (* Communication with field I/O - status *)
    COMM_BMS AT %QX0.2 : BOOL; (* Communication with BMS - status *)
    COMM_DEH AT %QX0.3 : BOOL; (* Communication with DEH - status *)
    BFP_A_START AT %QX0.4 : BOOL; (* Boiler feed pump A - start command - operator *)
    BFP_A_STOP AT %QX0.5 : BOOL; (* Boiler feed pump A - stop command - operator *)
    BFP_A_MODE AT %MD5 : DINT; (* Boiler feed pump A - mode - operator *)
    BFP_A_RUN AT %QX0.6 : BOOL; (* Boiler feed pump A - running - status *)
    BFP_A_TRIP AT %QX0.7 : BOOL; (* Boiler feed pump A - tripped - status *)
    BFP_A_PERM AT %QX1.0 : BOOL; (* Boiler feed pump A - start permissive - status *)
    BFP_A_ILK AT %QX1.1 : BOOL; (* Boiler feed pump A - protective interlock active - status *)
    BFP_B_START AT %QX1.2 : BOOL; (* Boiler feed pump B - start command - operator *)
    BFP_B_STOP AT %QX1.3 : BOOL; (* Boiler feed pump B - stop command - operator *)
    BFP_B_MODE AT %MD6 : DINT; (* Boiler feed pump B - mode - operator *)
    BFP_B_RUN AT %QX1.4 : BOOL; (* Boiler feed pump B - running - status *)
    BFP_B_TRIP AT %QX1.5 : BOOL; (* Boiler feed pump B - tripped - status *)
    BFP_B_PERM AT %QX1.6 : BOOL; (* Boiler feed pump B - start permissive - status *)
    BFP_B_ILK AT %QX1.7 : BOOL; (* Boiler feed pump B - protective interlock active - status *)
    BFP_C_START AT %QX2.0 : BOOL; (* Boiler feed pump C - start command - operator *)
    BFP_C_STOP AT %QX2.1 : BOOL; (* Boiler feed pump C - stop command - operator *)
    BFP_C_MODE AT %MD7 : DINT; (* Boiler feed pump C - mode - operator *)
    BFP_C_RUN AT %QX2.2 : BOOL; (* Boiler feed pump C - running - status *)
    BFP_C_TRIP AT %QX2.3 : BOOL; (* Boiler feed pump C - tripped - status *)
    BFP_C_PERM AT %QX2.4 : BOOL; (* Boiler feed pump C - start permissive - status *)
    BFP_C_ILK AT %QX2.5 : BOOL; (* Boiler feed pump C - protective interlock active - status *)
    EBD_OPEN AT %QX2.6 : BOOL; (* Emergency blowdown valve - open/close command - operator *)
    EBD_CLOSE AT %QX2.7 : BOOL; (* Emergency blowdown valve - close/open command - operator *)
    EBD_MODE AT %MD8 : DINT; (* Emergency blowdown valve - mode - operator *)
    EBD_OPENED AT %QX3.0 : BOOL; (* Emergency blowdown valve - open - status *)
    EBD_CLOSED AT %QX3.1 : BOOL; (* Emergency blowdown valve - closed - status *)
    EBD_PERM AT %QX3.2 : BOOL; (* Emergency blowdown valve - permissive - status *)
    EBD_ILK AT %QX3.3 : BOOL; (* Emergency blowdown valve - interlock active - status *)
    HPH_OPEN AT %QX3.4 : BOOL; (* HP heaters in service - open/close command - operator *)
    HPH_CLOSE AT %QX3.5 : BOOL; (* HP heaters in service - close/open command - operator *)
    HPH_MODE AT %MD9 : DINT; (* HP heaters in service - mode - operator *)
    HPH_OPENED AT %QX3.6 : BOOL; (* HP heaters in service - open - status *)
    HPH_CLOSED AT %QX3.7 : BOOL; (* HP heaters in service - closed - status *)
    HPH_PERM AT %QX4.0 : BOOL; (* HP heaters in service - permissive - status *)
    HPH_ILK AT %QX4.1 : BOOL; (* HP heaters in service - interlock active - status *)
    LIC_DRUM_PV AT %MD10 : REAL; (* Drum level master - process value [mm] - status *)
    LIC_DRUM_SP AT %MD11 : REAL; (* Drum level master - setpoint [mm] - operator *)
    LIC_DRUM_OUT AT %MD12 : REAL; (* Drum level master - output [%] - operator *)
    LIC_DRUM_MODE AT %MD13 : DINT; (* Drum level master - mode - operator *)
    LIC_DRUM_KP AT %MD14 : REAL; (* Drum level master - proportional gain - operator *)
    LIC_DRUM_TI AT %MD15 : REAL; (* Drum level master - integral time [s] - operator *)
    LIC_DRUM_TD AT %MD16 : REAL; (* Drum level master - derivative time [s] - operator *)
    LIC_DRUM_CSP AT %MD17 : REAL; (* Drum level master - cascade/remote setpoint [mm] - status *)
    LIC_DRUM_STS AT %MD18 : DINT; (* Drum level master - status bits - status *)
    FIC_FW_PV AT %MD19 : REAL; (* Feedwater flow (3-element) - process value [t/h] - status *)
    FIC_FW_SP AT %MD20 : REAL; (* Feedwater flow (3-element) - setpoint [t/h] - operator *)
    FIC_FW_OUT AT %MD21 : REAL; (* Feedwater flow (3-element) - output [%] - operator *)
    FIC_FW_MODE AT %MD22 : DINT; (* Feedwater flow (3-element) - mode - operator *)
    FIC_FW_KP AT %MD23 : REAL; (* Feedwater flow (3-element) - proportional gain - operator *)
    FIC_FW_TI AT %MD24 : REAL; (* Feedwater flow (3-element) - integral time [s] - operator *)
    FIC_FW_TD AT %MD25 : REAL; (* Feedwater flow (3-element) - derivative time [s] - operator *)
    FIC_FW_CSP AT %MD26 : REAL; (* Feedwater flow (3-element) - cascade/remote setpoint [t/h] - status *)
    FIC_FW_STS AT %MD27 : DINT; (* Feedwater flow (3-element) - status bits - status *)
    PIC_FWDP_PV AT %MD28 : REAL; (* Feedwater valve differential pressure (BFP master) - process value [bar] - status *)
    PIC_FWDP_SP AT %MD29 : REAL; (* Feedwater valve differential pressure (BFP master) - setpoint [bar] - operator *)
    PIC_FWDP_OUT AT %MD30 : REAL; (* Feedwater valve differential pressure (BFP master) - output [%] - operator *)
    PIC_FWDP_MODE AT %MD31 : DINT; (* Feedwater valve differential pressure (BFP master) - mode - operator *)
    PIC_FWDP_KP AT %MD32 : REAL; (* Feedwater valve differential pressure (BFP master) - proportional gain - operator *)
    PIC_FWDP_TI AT %MD33 : REAL; (* Feedwater valve differential pressure (BFP master) - integral time [s] - operator *)
    PIC_FWDP_TD AT %MD34 : REAL; (* Feedwater valve differential pressure (BFP master) - derivative time [s] - operator *)
    PIC_FWDP_CSP AT %MD35 : REAL; (* Feedwater valve differential pressure (BFP master) - cascade/remote setpoint [bar] - status *)
    PIC_FWDP_STS AT %MD36 : DINT; (* Feedwater valve differential pressure (BFP master) - status bits - status *)
    SC_BFPA_OUT AT %MD37 : REAL; (* BFP A speed (scoop) - output [%] - operator *)
    SC_BFPA_MODE AT %MD38 : DINT; (* BFP A speed (scoop) - mode - operator *)
    SC_BFPA_BIAS AT %MD39 : REAL; (* BFP A speed (scoop) - bias [%] - operator *)
    SC_BFPA_IN AT %MD40 : REAL; (* BFP A speed (scoop) - auto demand [%] - status *)
    SC_BFPA_FB AT %MD41 : REAL; (* BFP A speed (scoop) - position feedback [%] - status *)
    SC_BFPA_STS AT %MD42 : DINT; (* BFP A speed (scoop) - status bits - status *)
    SC_BFPB_OUT AT %MD43 : REAL; (* BFP B speed (scoop) - output [%] - operator *)
    SC_BFPB_MODE AT %MD44 : DINT; (* BFP B speed (scoop) - mode - operator *)
    SC_BFPB_BIAS AT %MD45 : REAL; (* BFP B speed (scoop) - bias [%] - operator *)
    SC_BFPB_IN AT %MD46 : REAL; (* BFP B speed (scoop) - auto demand [%] - status *)
    SC_BFPB_FB AT %MD47 : REAL; (* BFP B speed (scoop) - position feedback [%] - status *)
    SC_BFPB_STS AT %MD48 : DINT; (* BFP B speed (scoop) - status bits - status *)
    SC_BFPC_OUT AT %MD49 : REAL; (* BFP C speed (scoop) - output [%] - operator *)
    SC_BFPC_MODE AT %MD50 : DINT; (* BFP C speed (scoop) - mode - operator *)
    SC_BFPC_BIAS AT %MD51 : REAL; (* BFP C speed (scoop) - bias [%] - operator *)
    SC_BFPC_IN AT %MD52 : REAL; (* BFP C speed (scoop) - auto demand [%] - status *)
    SC_BFPC_FB AT %MD53 : REAL; (* BFP C speed (scoop) - position feedback [%] - status *)
    SC_BFPC_STS AT %MD54 : DINT; (* BFP C speed (scoop) - status bits - status *)
    LIC_DA_PV AT %MD55 : REAL; (* Deaerator level control - process value [mm] - status *)
    LIC_DA_SP AT %MD56 : REAL; (* Deaerator level control - setpoint [mm] - operator *)
    LIC_DA_OUT AT %MD57 : REAL; (* Deaerator level control - output [%] - operator *)
    LIC_DA_MODE AT %MD58 : DINT; (* Deaerator level control - mode - operator *)
    LIC_DA_KP AT %MD59 : REAL; (* Deaerator level control - proportional gain - operator *)
    LIC_DA_TI AT %MD60 : REAL; (* Deaerator level control - integral time [s] - operator *)
    LIC_DA_TD AT %MD61 : REAL; (* Deaerator level control - derivative time [s] - operator *)
    LIC_DA_CSP AT %MD62 : REAL; (* Deaerator level control - cascade/remote setpoint [mm] - status *)
    LIC_DA_STS AT %MD63 : DINT; (* Deaerator level control - status bits - status *)
    PIC_DA_PV AT %MD64 : REAL; (* Deaerator pegging steam pressure - process value [bar] - status *)
    PIC_DA_SP AT %MD65 : REAL; (* Deaerator pegging steam pressure - setpoint [bar] - operator *)
    PIC_DA_OUT AT %MD66 : REAL; (* Deaerator pegging steam pressure - output [%] - operator *)
    PIC_DA_MODE AT %MD67 : DINT; (* Deaerator pegging steam pressure - mode - operator *)
    PIC_DA_KP AT %MD68 : REAL; (* Deaerator pegging steam pressure - proportional gain - operator *)
    PIC_DA_TI AT %MD69 : REAL; (* Deaerator pegging steam pressure - integral time [s] - operator *)
    PIC_DA_TD AT %MD70 : REAL; (* Deaerator pegging steam pressure - derivative time [s] - operator *)
    PIC_DA_CSP AT %MD71 : REAL; (* Deaerator pegging steam pressure - cascade/remote setpoint [bar] - status *)
    PIC_DA_STS AT %MD72 : DINT; (* Deaerator pegging steam pressure - status bits - status *)
    HIC_CBD_OUT AT %MD73 : REAL; (* Continuous blowdown - output [%] - operator *)
    HIC_CBD_MODE AT %MD74 : DINT; (* Continuous blowdown - mode - operator *)
    HIC_CBD_BIAS AT %MD75 : REAL; (* Continuous blowdown - bias [%] - operator *)
    HIC_CBD_IN AT %MD76 : REAL; (* Continuous blowdown - auto demand [%] - status *)
    HIC_CBD_FB AT %MD77 : REAL; (* Continuous blowdown - position feedback [%] - status *)
    HIC_CBD_STS AT %MD78 : DINT; (* Continuous blowdown - status bits - status *)
    ELEM_SEL AT %MD79 : DINT; (* Drum level element selection - operator *)
    DP_SP_MODE AT %MD80 : DINT; (* FW DP setpoint program - operator *)
    DRUM_LVL_SEL AT %MD81 : REAL; (* Drum level (median of 3) [mm] - status *)
    FW_DP AT %MD82 : REAL; (* Feedwater valve differential pressure [bar] - status *)
    BFP_MASTER AT %MD83 : REAL; (* BFP master demand [%] - status *)
    STEAM_FLOW_PCT AT %MD84 : REAL; (* Steam flow (% MCR) [%] - status *)
    BFP_RUNNING AT %MD85 : DINT; (* Number of BFPs running - status *)
    E3_ACTIVE AT %QX4.2 : BOOL; (* Three-element control active - status *)
    LT_DEVIATION AT %QX4.3 : BOOL; (* Drum level transmitter deviation - status *)
    LVL_AUTO AT %QX4.4 : BOOL; (* Drum level control in automatic - status *)
    RB_BFP AT %QX4.5 : BOOL; (* BFP runback request - status *)
    IO_COMM_PLANT AT %QX4.6 : BOOL; (* Bridge: field I/O link healthy - bridge in *)
    IO_COMM_BMS AT %QX4.7 : BOOL; (* Bridge: BMS link and heartbeat healthy - bridge in *)
    IO_COMM_DEH AT %QX5.0 : BOOL; (* Bridge: DEH link and heartbeat healthy - bridge in *)
    IO_IC_SEQ AT %MD86 : DINT; (* Bridge: initial-condition command sequence - bridge in *)
    IO_IC_ID AT %MD87 : DINT; (* Bridge: initial condition number - bridge in *)
    IO_IC_SNAP AT %QX5.1 : BOOL; (* Bridge: controller values restored from a snapshot - bridge in *)
    I_BFP_A_RUN AT %QX5.2 : BOOL; (* Field input: Boiler feed pump A running - bridge in *)
    I_BFP_A_SPEED AT %MD88 : REAL; (* Field input: BFP A speed [rpm] - bridge in *)
    I_BFP_A_TRIP AT %QX5.3 : BOOL; (* Field input: Boiler feed pump A tripped - bridge in *)
    I_BFP_B_RUN AT %QX5.4 : BOOL; (* Field input: Boiler feed pump B running - bridge in *)
    I_BFP_B_SPEED AT %MD89 : REAL; (* Field input: BFP B speed [rpm] - bridge in *)
    I_BFP_B_TRIP AT %QX5.5 : BOOL; (* Field input: Boiler feed pump B tripped - bridge in *)
    I_BFP_C_RUN AT %QX5.6 : BOOL; (* Field input: Boiler feed pump C running - bridge in *)
    I_BFP_C_SPEED AT %MD90 : REAL; (* Field input: BFP C speed [rpm] - bridge in *)
    I_BFP_C_TRIP AT %QX5.7 : BOOL; (* Field input: Boiler feed pump C tripped - bridge in *)
    I_CBD_FB AT %MD91 : REAL; (* Field input: Continuous blowdown valve position [%] - bridge in *)
    I_CEP_A_RUN AT %QX6.0 : BOOL; (* Field input: Condensate pump A running - bridge in *)
    I_CEP_B_RUN AT %QX6.1 : BOOL; (* Field input: Condensate pump B running - bridge in *)
    I_DA_CV_FB AT %MD92 : REAL; (* Field input: Deaerator level control valve position [%] - bridge in *)
    I_DA_LVL AT %MD93 : REAL; (* Field input: Deaerator storage tank level [mm] - bridge in *)
    I_DA_PRESS AT %MD94 : REAL; (* Field input: Deaerator pressure [bar] - bridge in *)
    I_DRUM_LVL_A AT %MD95 : REAL; (* Field input: Drum level transmitter A [mm] - bridge in *)
    I_DRUM_LVL_B AT %MD96 : REAL; (* Field input: Drum level transmitter B [mm] - bridge in *)
    I_DRUM_LVL_C AT %MD97 : REAL; (* Field input: Drum level transmitter C [mm] - bridge in *)
    I_DRUM_PRESS AT %MD98 : REAL; (* Field input: Drum pressure [bar] - bridge in *)
    I_EBD_OPEN AT %QX6.2 : BOOL; (* Field input: Emergency blowdown valve open - bridge in *)
    I_FCV_FB AT %MD99 : REAL; (* Field input: Feedwater control valve position [%] - bridge in *)
    I_FW_FLOW AT %MD100 : REAL; (* Field input: Feedwater flow to economizer [t/h] - bridge in *)
    I_FW_HDR_PRESS AT %MD101 : REAL; (* Field input: BFP discharge header pressure [bar] - bridge in *)
    I_GCB_CLOSED AT %QX6.3 : BOOL; (* Field input: Generator circuit breaker (52G) closed - bridge in *)
    I_HPH_IN_SERVICE AT %QX6.4 : BOOL; (* Field input: HP heaters in service - bridge in *)
    I_PEG_FB AT %MD102 : REAL; (* Field input: Deaerator pegging steam valve position [%] - bridge in *)
    I_SH_SPRAY_FLOW AT %MD103 : REAL; (* Field input: SH attemperator spray flow [t/h] - bridge in *)
    I_SIM_TIME_MS AT %MD104 : UDINT; (* Field input: Simulation clock [ms] - bridge in *)
    I_STEAM_FLOW AT %MD105 : REAL; (* Field input: Main steam flow [t/h] - bridge in *)
    IC_ACK AT %MD106 : DINT; (* Last initial-condition command acknowledged - status *)
    Q_BFP_A_CMD AT %QX6.5 : BOOL; (* Field output: BFP_A run command - status *)
    Q_BFP_A_SPD_DMD AT %MD107 : REAL; (* Field output: BFP A hydraulic coupling scoop demand [%] - status *)
    Q_BFP_B_CMD AT %QX6.6 : BOOL; (* Field output: BFP_B run command - status *)
    Q_BFP_B_SPD_DMD AT %MD108 : REAL; (* Field output: BFP B hydraulic coupling scoop demand [%] - status *)
    Q_BFP_C_CMD AT %QX6.7 : BOOL; (* Field output: BFP_C run command - status *)
    Q_BFP_C_SPD_DMD AT %MD109 : REAL; (* Field output: BFP C hydraulic coupling scoop demand [%] - status *)
    Q_CBD_DMD AT %MD110 : REAL; (* Field output: Continuous blowdown valve demand [%] - status *)
    Q_DA_CV_DMD AT %MD111 : REAL; (* Field output: Deaerator level control valve demand [%] - status *)
    Q_EBD_CMD AT %QX7.0 : BOOL; (* Field output: Emergency blowdown valve open - status *)
    Q_FCV_DMD AT %MD112 : REAL; (* Field output: Feedwater control valve demand [%] - status *)
    Q_HPH_CMD AT %QX7.1 : BOOL; (* Field output: HP heaters in service - status *)
    Q_PEG_DMD AT %MD113 : REAL; (* Field output: Deaerator pegging steam valve demand [%] - status *)
  END_VAR
  VAR
    RT : FB_PLC_RUNTIME;
    BFP_A : FB_MOTOR;
    BFP_B : FB_MOTOR;
    BFP_C : FB_MOTOR;
    EBD : FB_ONOFF;
    HPH : FB_ONOFF;
    LIC_DRUM : FB_LOOP;
    FIC_FW : FB_LOOP;
    PIC_FWDP : FB_LOOP;
    SC_BFPA : FB_STATION;
    SC_BFPB : FB_STATION;
    SC_BFPC : FB_STATION;
    LIC_DA : FB_LOOP;
    PIC_DA : FB_LOOP;
    HIC_CBD : FB_STATION;
    T_LTDEV : FB_TONS;
    T_RBBFP : FB_TONS;
    dts : REAL;
    init : BOOL;
    keep : BOOL;
    keepCbd : BOOL;
    lvl : REAL;
    steam : REAL;
    spray : REAL;
    fw : REAL;
    ff : REAL;
    steamPct : REAL;
    e3 : BOOL;
    e3Latch : BOOL;
    e3Changed : BOOL;
    e3Trk : REAL;
    ficCas : BOOL;
    nRun : DINT;
    daLvl : REAL;
    dp : REAL;
    dpSp : REAL;
    anyAuto : BOOL;
    avgScoop : REAL;
    master : REAL;
    tripA : BOOL;
    tripB : BOOL;
    tripC : BOOL;
    runPrevA : BOOL;
    runPrevB : BOOL;
    runPrevC : BOOL;
    joinA : BOOL;
    joinB : BOOL;
    joinC : BOOL;
    cep : BOOL;
  END_VAR
  VAR CONSTANT
    MCR_STEAM : REAL := 2149.0;   (* t/h *)
    TRIM_GAIN : REAL := 12.0;     (* t/h per % of level master output in 3-element mode *)
  END_VAR
  VAR
    (* branch conditions of the function block diagram *)
    IF2 : BOOL; (* IF ELEM_SEL = 1 THEN *)
    IF2_2 : BOOL; (* ELSIF ELEM_SEL = 2 THEN *)
    IF2_ELSE : BOOL; (* ELSE (none of: ELEM_SEL = 1 / ELEM_SEL = 2) *)
    IF4 : BOOL; (* IF I_BFP_A_RUN THEN *)
    IF4_ELSE : BOOL; (* ELSE (none of: I_BFP_A_RUN) *)
    IF5 : BOOL; (* IF I_BFP_B_RUN THEN *)
    IF5_ELSE : BOOL; (* ELSE (none of: I_BFP_B_RUN) *)
    IF6 : BOOL; (* IF I_BFP_C_RUN THEN *)
    IF6_ELSE : BOOL; (* ELSE (none of: I_BFP_C_RUN) *)
    IF7 : BOOL; (* IF I_BFP_A_RUN AND IO_IC_ID >= 2 THEN *)
    IF7_ELSE : BOOL; (* ELSE (none of: I_BFP_A_RUN AND IO_IC_ID >= 2) *)
    IF8 : BOOL; (* IF I_BFP_B_RUN AND IO_IC_ID >= 2 THEN *)
    IF8_ELSE : BOOL; (* ELSE (none of: I_BFP_B_RUN AND IO_IC_ID >= 2) *)
    IF9 : BOOL; (* IF I_BFP_C_RUN AND IO_IC_ID >= 2 THEN *)
    IF9_ELSE : BOOL; (* ELSE (none of: I_BFP_C_RUN AND IO_IC_ID >= 2) *)
    IF10 : BOOL; (* IF I_BFP_A_RUN THEN *)
    IF10_2 : BOOL; (* ELSIF I_BFP_B_RUN THEN *)
    IF10_3 : BOOL; (* ELSIF I_BFP_C_RUN THEN *)
    IF10_ELSE : BOOL; (* ELSE (none of: I_BFP_A_RUN / I_BFP_B_RUN / I_BFP_C_RUN) *)
    IF11 : BOOL; (* IF e3Latch THEN *)
    IF11_ELSE : BOOL; (* ELSE (none of: e3Latch) *)
    IF12 : BOOL; (* IF IO_IC_ID >= 2 THEN *)
    IF12_ELSE : BOOL; (* ELSE (none of: IO_IC_ID >= 2) *)
    IF14 : BOOL; (* IF ELEM_SEL = 1 THEN *)
    IF14_2 : BOOL; (* ELSIF ELEM_SEL = 2 THEN *)
    IF14_3 : BOOL; (* ELSIF e3Latch THEN *)
    IF14_ELSE : BOOL; (* ELSE (none of: ELEM_SEL = 1 / ELEM_SEL = 2 / e3Latch) *)
    IF15 : BOOL; (* IF e3Changed THEN *)
    IF16 : BOOL; (* IF e3 THEN *)
    IF16_ELSE : BOOL; (* ELSE (none of: e3) *)
    IF17 : BOOL; (* IF NOT e3 THEN *)
    IF17_ELSE : BOOL; (* ELSE (none of: NOT e3) *)
    IF18 : BOOL; (* IF I_BFP_A_RUN THEN *)
    IF19 : BOOL; (* IF I_BFP_B_RUN THEN *)
    IF20 : BOOL; (* IF I_BFP_C_RUN THEN *)
    IF21 : BOOL; (* IF I_BFP_A_RUN AND NOT runPrevA AND BFP_A.IS_AUTO AND tripB OR tripC THEN *)
    IF22 : BOOL; (* IF I_BFP_B_RUN AND NOT runPrevB AND BFP_B.IS_AUTO AND tripA OR tripC THEN *)
    IF23 : BOOL; (* IF I_BFP_C_RUN AND NOT runPrevC AND BFP_C.IS_AUTO AND tripA OR tripB THEN *)
    IF24 : BOOL; (* IF I_BFP_A_RUN THEN *)
    IF25 : BOOL; (* IF I_BFP_B_RUN THEN *)
    IF26 : BOOL; (* IF I_BFP_C_RUN THEN *)
    IF27 : BOOL; (* IF nRun > 0 THEN *)
    IF28 : BOOL; (* IF steamPct <= 30.0 THEN *)
    IF28_ELSE : BOOL; (* ELSE (none of: steamPct <= 30.0) *)
  END_VAR

