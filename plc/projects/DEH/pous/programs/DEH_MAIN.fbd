(* DEH - Turbine Control & Protection (digital electro-hydraulic governor)
   Turbine protection with first-out and latch (reset) permissives; operating modes SPEED
   (run-up through the critical speed bands, synchroniser trim from GEN), LOAD (local load
   reference with frequency droop), REMOTE (load reference from CCS) and PRESSURE (turbine
   follow, throttle pressure from CCS); valve position and throttle pressure limiters; OPC
   (overspeed protection controller) on load rejection; turbine stress evaluator (TSE) limits
   the ramp rates; HP / LP bypass FIXED / FOLLOW pressure control; SH start-up vent.
   Naming: I_* field inputs, Q_* field outputs, P_<PEER>_* peer status, IO_* bridge signals.
   LOAD_REF_REM / PRESS_SP_REM / CCS_REQ are written into this PLC by CCS, SYNC_ADJ /
   SYNC_ACTIVE by GEN. *)
PROGRAM DEH_MAIN
  VAR
    (* Register map of DEH (generated by scripts/plc-build.js - do not edit here) *)
    HEARTBEAT AT %MD0 : DINT; (* Controller heartbeat counter - status *)
    SCAN_MS AT %MD1 : REAL; (* Logic execution time [ms] - status *)
    SIM_DT AT %MD2 : REAL; (* Simulation time step of last scan [s] - status *)
    IC_APPLIED AT %MD3 : DINT; (* Last applied initial condition - status *)
    SCAN_COUNT AT %MD4 : UDINT; (* Scan counter - status *)
    HEALTHY AT %QX0.0 : BOOL; (* Controller healthy - status *)
    COMM_PLANT AT %QX0.1 : BOOL; (* Communication with field I/O - status *)
    COMM_BMS AT %QX0.2 : BOOL; (* Communication with BMS - status *)
    COMM_GEN AT %QX0.3 : BOOL; (* Communication with GEN - status *)
    COMM_CCS AT %QX0.4 : BOOL; (* Communication with CCS - status *)
    RESET AT %QX0.5 : BOOL; (* Turbine reset / latch - operator *)
    TRIP_PB AT %QX0.6 : BOOL; (* Manual turbine trip - operator *)
    GO AT %QX0.7 : BOOL; (* Speed / load ramp GO - operator *)
    HOLD AT %QX1.0 : BOOL; (* Speed / load ramp HOLD - operator *)
    SPD_TARGET AT %MD5 : REAL; (* Speed target [rpm] - operator *)
    SPD_RATE AT %MD6 : REAL; (* Acceleration rate [rpm/min] - operator *)
    LOAD_TARGET AT %MD7 : REAL; (* Load target (local) [MW] - operator *)
    LOAD_RATE AT %MD8 : REAL; (* Loading rate (local) [MW/min] - operator *)
    VPL AT %MD9 : REAL; (* Valve position limit [%] - operator *)
    FREQ_ON AT %MD10 : DINT; (* Primary frequency response - operator *)
    DROOP AT %MD11 : REAL; (* Speed droop [%] - operator *)
    MODE_SEL AT %MD12 : DINT; (* Operator mode selection - operator *)
    TPL_SP AT %MD13 : REAL; (* Throttle pressure limiter [bar] - operator *)
    SPD_CTRL_PV AT %MD14 : REAL; (* Turbine speed control - process value [rpm] - status *)
    SPD_CTRL_SP AT %MD15 : REAL; (* Turbine speed control - setpoint [rpm] - operator *)
    SPD_CTRL_OUT AT %MD16 : REAL; (* Turbine speed control - output [%] - operator *)
    SPD_CTRL_MODE AT %MD17 : DINT; (* Turbine speed control - mode - operator *)
    SPD_CTRL_KP AT %MD18 : REAL; (* Turbine speed control - proportional gain - operator *)
    SPD_CTRL_TI AT %MD19 : REAL; (* Turbine speed control - integral time [s] - operator *)
    SPD_CTRL_TD AT %MD20 : REAL; (* Turbine speed control - derivative time [s] - operator *)
    SPD_CTRL_CSP AT %MD21 : REAL; (* Turbine speed control - cascade/remote setpoint [rpm] - status *)
    SPD_CTRL_STS AT %MD22 : DINT; (* Turbine speed control - status bits - status *)
    LOAD_CTRL_PV AT %MD23 : REAL; (* Turbine load control - process value [MW] - status *)
    LOAD_CTRL_SP AT %MD24 : REAL; (* Turbine load control - setpoint [MW] - operator *)
    LOAD_CTRL_OUT AT %MD25 : REAL; (* Turbine load control - output [%] - operator *)
    LOAD_CTRL_MODE AT %MD26 : DINT; (* Turbine load control - mode - operator *)
    LOAD_CTRL_KP AT %MD27 : REAL; (* Turbine load control - proportional gain - operator *)
    LOAD_CTRL_TI AT %MD28 : REAL; (* Turbine load control - integral time [s] - operator *)
    LOAD_CTRL_TD AT %MD29 : REAL; (* Turbine load control - derivative time [s] - operator *)
    LOAD_CTRL_CSP AT %MD30 : REAL; (* Turbine load control - cascade/remote setpoint [MW] - status *)
    LOAD_CTRL_STS AT %MD31 : DINT; (* Turbine load control - status bits - status *)
    PIC_TPT_PV AT %MD32 : REAL; (* Throttle pressure control (turbine follow) - process value [bar] - status *)
    PIC_TPT_SP AT %MD33 : REAL; (* Throttle pressure control (turbine follow) - setpoint [bar] - operator *)
    PIC_TPT_OUT AT %MD34 : REAL; (* Throttle pressure control (turbine follow) - output [%] - operator *)
    PIC_TPT_MODE AT %MD35 : DINT; (* Throttle pressure control (turbine follow) - mode - operator *)
    PIC_TPT_KP AT %MD36 : REAL; (* Throttle pressure control (turbine follow) - proportional gain - operator *)
    PIC_TPT_TI AT %MD37 : REAL; (* Throttle pressure control (turbine follow) - integral time [s] - operator *)
    PIC_TPT_TD AT %MD38 : REAL; (* Throttle pressure control (turbine follow) - derivative time [s] - operator *)
    PIC_TPT_CSP AT %MD39 : REAL; (* Throttle pressure control (turbine follow) - cascade/remote setpoint [bar] - status *)
    PIC_TPT_STS AT %MD40 : DINT; (* Throttle pressure control (turbine follow) - status bits - status *)
    PIC_HPB_PV AT %MD41 : REAL; (* HP bypass pressure control - process value [bar] - status *)
    PIC_HPB_SP AT %MD42 : REAL; (* HP bypass pressure control - setpoint [bar] - operator *)
    PIC_HPB_OUT AT %MD43 : REAL; (* HP bypass pressure control - output [%] - operator *)
    PIC_HPB_MODE AT %MD44 : DINT; (* HP bypass pressure control - mode - operator *)
    PIC_HPB_KP AT %MD45 : REAL; (* HP bypass pressure control - proportional gain - operator *)
    PIC_HPB_TI AT %MD46 : REAL; (* HP bypass pressure control - integral time [s] - operator *)
    PIC_HPB_TD AT %MD47 : REAL; (* HP bypass pressure control - derivative time [s] - operator *)
    PIC_HPB_CSP AT %MD48 : REAL; (* HP bypass pressure control - cascade/remote setpoint [bar] - status *)
    PIC_HPB_STS AT %MD49 : DINT; (* HP bypass pressure control - status bits - status *)
    PIC_LPB_PV AT %MD50 : REAL; (* LP bypass (hot reheat pressure) control - process value [bar] - status *)
    PIC_LPB_SP AT %MD51 : REAL; (* LP bypass (hot reheat pressure) control - setpoint [bar] - operator *)
    PIC_LPB_OUT AT %MD52 : REAL; (* LP bypass (hot reheat pressure) control - output [%] - operator *)
    PIC_LPB_MODE AT %MD53 : DINT; (* LP bypass (hot reheat pressure) control - mode - operator *)
    PIC_LPB_KP AT %MD54 : REAL; (* LP bypass (hot reheat pressure) control - proportional gain - operator *)
    PIC_LPB_TI AT %MD55 : REAL; (* LP bypass (hot reheat pressure) control - integral time [s] - operator *)
    PIC_LPB_TD AT %MD56 : REAL; (* LP bypass (hot reheat pressure) control - derivative time [s] - operator *)
    PIC_LPB_CSP AT %MD57 : REAL; (* LP bypass (hot reheat pressure) control - cascade/remote setpoint [bar] - status *)
    PIC_LPB_STS AT %MD58 : DINT; (* LP bypass (hot reheat pressure) control - status bits - status *)
    HPB_MODE AT %MD59 : DINT; (* HP bypass setpoint mode - operator *)
    HPB_RAMP AT %MD60 : REAL; (* HP bypass setpoint ramp rate [bar/min] - operator *)
    HPB_TARGET AT %MD61 : REAL; (* HP bypass pressure target [bar] - operator *)
    SH_VENT_OPEN AT %QX1.1 : BOOL; (* SH start-up vent - open/close command - operator *)
    SH_VENT_CLOSE AT %QX1.2 : BOOL; (* SH start-up vent - close/open command - operator *)
    SH_VENT_MODE AT %MD62 : DINT; (* SH start-up vent - mode - operator *)
    SH_VENT_OPENED AT %QX1.3 : BOOL; (* SH start-up vent - open - status *)
    SH_VENT_CLOSED AT %QX1.4 : BOOL; (* SH start-up vent - closed - status *)
    SH_VENT_PERM AT %QX1.5 : BOOL; (* SH start-up vent - permissive - status *)
    SH_VENT_ILK AT %QX1.6 : BOOL; (* SH start-up vent - interlock active - status *)
    TRIPPED AT %QX1.7 : BOOL; (* Turbine tripped - status *)
    LATCHED AT %QX2.0 : BOOL; (* Turbine latched (reset) - status *)
    MODE AT %MD63 : DINT; (* DEH operating mode - status *)
    TRIP_CAUSE AT %MD64 : DINT; (* Turbine trip first-out - status *)
    SPEED AT %MD65 : REAL; (* Turbine speed (median) [rpm] - status *)
    SPEED_REF AT %MD66 : REAL; (* Speed reference [rpm] - status *)
    LOAD_REF AT %MD67 : REAL; (* Load reference [MW] - status *)
    FREQ_CORR AT %MD68 : REAL; (* Frequency correction [MW] - status *)
    GV_DEMAND AT %MD69 : REAL; (* Governor valve demand [%] - status *)
    STRESS_HP AT %MD70 : REAL; (* HP rotor stress (TSE) [%] - status *)
    STRESS_IP AT %MD71 : REAL; (* IP rotor stress (TSE) [%] - status *)
    START_CLASS AT %MD72 : DINT; (* Start classification - status *)
    MAX_VIB AT %MD73 : REAL; (* Highest shaft vibration [um] - status *)
    RAMP_ACTIVE AT %QX2.1 : BOOL; (* Speed / load ramp in progress - status *)
    OPC_ACTIVE AT %QX2.2 : BOOL; (* Overspeed protection controller active - status *)
    CRIT_ZONE AT %QX2.3 : BOOL; (* Speed within critical band - status *)
    AT_SPEED AT %QX2.4 : BOOL; (* Turbine at synchronous speed - status *)
    REM_READY AT %QX2.5 : BOOL; (* Ready for CCS remote control - status *)
    TPL_ACTIVE AT %QX2.6 : BOOL; (* Throttle pressure limiter active - status *)
    LPB_ILK AT %QX2.7 : BOOL; (* LP bypass interlocked (condenser not available) - status *)
    LATCH_PERM AT %QX3.0 : BOOL; (* Turbine latch permissive - status *)
    CCS_HB AT %MD74 : DINT; (* CCS heartbeat (peer write) - written by CCS *)
    LOAD_REF_REM AT %MD75 : REAL; (* Load reference from CCS [MW] - written by CCS *)
    PRESS_SP_REM AT %MD76 : REAL; (* Throttle pressure setpoint from CCS [bar] - written by CCS *)
    CCS_REQ AT %MD77 : DINT; (* CCS request - written by CCS *)
    GEN_HB AT %MD78 : DINT; (* GEN heartbeat (peer write) - written by GEN *)
    SYNC_ADJ AT %MD79 : REAL; (* Synchroniser speed adjust [rpm/s] - written by GEN *)
    SYNC_ACTIVE AT %MD80 : DINT; (* Auto synchroniser active - written by GEN *)
    IO_COMM_PLANT AT %QX3.1 : BOOL; (* Bridge: field I/O link healthy - bridge in *)
    IO_COMM_BMS AT %QX3.2 : BOOL; (* Bridge: BMS link and heartbeat healthy - bridge in *)
    IO_COMM_GEN AT %QX3.3 : BOOL; (* Bridge: GEN link and heartbeat healthy - bridge in *)
    IO_COMM_CCS AT %QX3.4 : BOOL; (* Bridge: CCS link and heartbeat healthy - bridge in *)
    IO_IC_SEQ AT %MD81 : DINT; (* Bridge: initial-condition command sequence - bridge in *)
    IO_IC_ID AT %MD82 : DINT; (* Bridge: initial condition number - bridge in *)
    IO_IC_SNAP AT %QX3.5 : BOOL; (* Bridge: controller values restored from a snapshot - bridge in *)
    I_AXIAL_DISP AT %MD83 : REAL; (* Field input: Rotor axial displacement [mm] - bridge in *)
    I_BRG_T_1 AT %MD84 : REAL; (* Field input: Bearing 1 metal temperature [degC] - bridge in *)
    I_BRG_T_2 AT %MD85 : REAL; (* Field input: Bearing 2 metal temperature [degC] - bridge in *)
    I_BRG_T_3 AT %MD86 : REAL; (* Field input: Bearing 3 metal temperature [degC] - bridge in *)
    I_BRG_T_4 AT %MD87 : REAL; (* Field input: Bearing 4 metal temperature [degC] - bridge in *)
    I_BRG_T_5 AT %MD88 : REAL; (* Field input: Bearing 5 metal temperature [degC] - bridge in *)
    I_BRG_T_6 AT %MD89 : REAL; (* Field input: Bearing 6 metal temperature [degC] - bridge in *)
    I_COND_PRESS AT %MD90 : REAL; (* Field input: Condenser pressure (abs) [mbar] - bridge in *)
    I_CW_FLOW AT %MD91 : REAL; (* Field input: Circulating water flow [t/h] - bridge in *)
    I_DEH_WD_FAIL AT %QX3.6 : BOOL; (* Field input: DEH watchdog failure (hardwired turbine trip) - bridge in *)
    I_DRUM_PRESS AT %MD92 : REAL; (* Field input: Drum pressure [bar] - bridge in *)
    I_GCB_CLOSED AT %QX3.7 : BOOL; (* Field input: Generator circuit breaker (52G) closed - bridge in *)
    I_GEN_MW AT %MD93 : REAL; (* Field input: Generator active power [MW] - bridge in *)
    I_GRID_FREQ AT %MD94 : REAL; (* Field input: Grid frequency [Hz] - bridge in *)
    I_GV_POS AT %MD95 : REAL; (* Field input: HP governor (control) valve position [%] - bridge in *)
    I_HPB_POS AT %MD96 : REAL; (* Field input: HP bypass valve position [%] - bridge in *)
    I_HP_EXH_TEMP AT %MD97 : REAL; (* Field input: HP exhaust temperature [degC] - bridge in *)
    I_HP_METAL_TEMP AT %MD98 : REAL; (* Field input: HP inner casing metal temperature [degC] - bridge in *)
    I_HRH_PRESS AT %MD99 : REAL; (* Field input: Hot reheat pressure [bar] - bridge in *)
    I_HRH_TEMP AT %MD100 : REAL; (* Field input: Hot reheat temperature [degC] - bridge in *)
    I_IP_METAL_TEMP AT %MD101 : REAL; (* Field input: IP inner casing metal temperature [degC] - bridge in *)
    I_LO_PRESS AT %MD102 : REAL; (* Field input: Lube oil header pressure [bar] - bridge in *)
    I_LPB_POS AT %MD103 : REAL; (* Field input: LP bypass valve position [%] - bridge in *)
    I_MECH_OVERSPEED AT %QX4.0 : BOOL; (* Field input: Mechanical overspeed bolt tripped - bridge in *)
    I_MSV_OPEN AT %QX4.1 : BOOL; (* Field input: Main stop valves open - bridge in *)
    I_MS_PRESS AT %MD104 : REAL; (* Field input: Main steam (throttle) pressure [bar] - bridge in *)
    I_MS_TEMP AT %MD105 : REAL; (* Field input: Main steam temperature [degC] - bridge in *)
    I_SH_VENT_OPEN AT %QX4.2 : BOOL; (* Field input: SH start-up vent open - bridge in *)
    I_SIM_TIME_MS AT %MD106 : UDINT; (* Field input: Simulation clock [ms] - bridge in *)
    I_SPEED_A AT %MD107 : REAL; (* Field input: Turbine speed probe A [rpm] - bridge in *)
    I_SPEED_B AT %MD108 : REAL; (* Field input: Turbine speed probe B [rpm] - bridge in *)
    I_SPEED_C AT %MD109 : REAL; (* Field input: Turbine speed probe C [rpm] - bridge in *)
    I_VIB_1 AT %MD110 : REAL; (* Field input: Bearing 1 shaft vibration [um] - bridge in *)
    I_VIB_2 AT %MD111 : REAL; (* Field input: Bearing 2 shaft vibration [um] - bridge in *)
    I_VIB_3 AT %MD112 : REAL; (* Field input: Bearing 3 shaft vibration [um] - bridge in *)
    I_VIB_4 AT %MD113 : REAL; (* Field input: Bearing 4 shaft vibration [um] - bridge in *)
    I_VIB_5 AT %MD114 : REAL; (* Field input: Bearing 5 shaft vibration [um] - bridge in *)
    I_VIB_6 AT %MD115 : REAL; (* Field input: Bearing 6 shaft vibration [um] - bridge in *)
    P_BMS_FUEL_IN_SERVICE AT %QX4.3 : BOOL; (* From BMS: Fuel in service - bridge in *)
    P_BMS_MFT AT %QX4.4 : BOOL; (* From BMS: Master fuel trip active - bridge in *)
    P_GEN_LOCKOUT_86 AT %QX4.5 : BOOL; (* From GEN: Generator lockout relay 86G operated - bridge in *)
    IC_ACK AT %MD116 : DINT; (* Last initial-condition command acknowledged - status *)
    Q_DEH_WD AT %MD117 : DINT; (* Field output: DEH watchdog counter - status *)
    Q_GV_DMD AT %MD118 : REAL; (* Field output: Governor valve demand [%] - status *)
    Q_HPB_DMD AT %MD119 : REAL; (* Field output: HP bypass valve demand [%] - status *)
    Q_ICV_DMD AT %MD120 : REAL; (* Field output: Intercept valve demand [%] - status *)
    Q_LPB_DMD AT %MD121 : REAL; (* Field output: LP bypass valve demand [%] - status *)
    Q_MSV_CMD AT %QX4.6 : BOOL; (* Field output: Main stop valves open - status *)
    Q_RSV_CMD AT %QX4.7 : BOOL; (* Field output: Reheat stop valves open - status *)
    Q_SH_VENT_CMD AT %QX5.0 : BOOL; (* Field output: SH start-up vent open - status *)
    Q_TURB_TRIP AT %QX5.1 : BOOL; (* Field output: Turbine trip (1 = tripped) - status *)
  END_VAR
  VAR
    RT : FB_PLC_RUNTIME;
    SPD_CTRL : FB_LOOP;
    LOAD_CTRL : FB_LOOP;
    PIC_TPT : FB_LOOP;
    PIC_HPB : FB_LOOP;
    PIC_LPB : FB_LOOP;
    SH_VENT : FB_ONOFF;
    T_VIBHH : FB_TONS;
    T_HPXHH : FB_TONS;
    T_HPBCLOSED : FB_TONS;
    dts : REAL;
    init : BOOL;
    n : REAL;
    gcb : BOOL;
    mw : REAL;
    pms : REAL;
    vib : REAL;
    brg : REAL;
    nOver : INT;
    c : ARRAY[1..12] OF BOOL;   (* trip conditions, by first-out cause number *)
    firstOut : DINT;
    tripActive : BOOL;
    latchPerm : BOOL;
    latch : BOOL;              (* turbine latched (reset) *)
    latchPrev : BOOL;
    latchFell : BOOL;
    spdResync : BOOL;
    cause : DINT;
    req : DINT;
    remoteSel : BOOL;
    dehMode : DINT;            (* 0 TRIPPED, 1 SPEED, 2 LOAD, 3 REMOTE, 4 PRESSURE *)
    gcbPrev : BOOL;
    gcbRose : BOOL;
    gcbFell : BOOL;
    lastMw : REAL;
    opcT : REAL;
    opcLatch : BOOL;
    opc : BOOL;
    hpMetal : REAL;
    flowing : BOOL;
    stressHp : REAL;
    stressIp : REAL;
    stressFactor : REAL;
    spdGo : BOOL;
    loadGo : BOOL;
    spdRef : REAL;
    loadRef : REAL;
    target : REAL;
    rate : REAL;
    banded : BOOL;
    df : REAL;
    dfDb : REAL;
    droopPu : REAL;
    fcorr : REAL;
    tgt : REAL;
    r : REAL;
    tpl : BOOL;
    gvHi : REAL;
    pFilt : REAL;
    gv : REAL;
    spLoad : REAL;
    ffGv : REAL;
    lpbIlk : BOOL;
    follow : BOOL;
    hpbSp : REAL;
    lpbSp : REAL;
    fired : BOOL;
    pd : REAL;
  END_VAR
  VAR CONSTANT
    RPM : REAL := 3600.0;      (* 2-pole generator on a 60 Hz grid *)
    M_TRIPPED : DINT := 0;
    M_SPEED : DINT := 1;
    M_LOAD : DINT := 2;
    M_REMOTE : DINT := 3;
    M_PRESSURE : DINT := 4;
  END_VAR
  VAR
    (* branch conditions of the function block diagram *)
    IF2 : BOOL; (* IF IO_IC_ID >= 2 THEN *)
    IF2_ELSE : BOOL; (* ELSE (none of: IO_IC_ID >= 2) *)
    IF3 : BOOL; (* IF I_MSV_OPEN THEN *)
    IF4 : BOOL; (* IF gcb THEN *)
    IF6 : BOOL; (* IF latch THEN *)
    IF6_2 : BOOL; (* ELSIF IO_IC_ID = 1 THEN *)
    IF6_ELSE : BOOL; (* ELSE (none of: latch / IO_IC_ID = 1) *)
    IF7 : BOOL; (* IF HPB_MODE = 1 THEN *)
    IF7_ELSE : BOOL; (* ELSE (none of: HPB_MODE = 1) *)
    IF9 : BOOL; (* IF I_SPEED_A > RPM * 1.1 THEN *)
    IF10 : BOOL; (* IF I_SPEED_B > RPM * 1.1 THEN *)
    IF11 : BOOL; (* IF I_SPEED_C > RPM * 1.1 THEN *)
    IF12 : BOOL; (* IF latch AND firstOut > 0 THEN *)
    IF13 : BOOL; (* IF RESET AND latchPerm THEN *)
    IF14 : BOOL; (* IF IO_COMM_CCS THEN *)
    IF14_ELSE : BOOL; (* ELSE (none of: IO_COMM_CCS) *)
    IF15 : BOOL; (* IF latch THEN *)
    IF16 : BOOL; (* IF NOT gcb THEN *)
    IF16_2 : BOOL; (* ELSIF remoteSel AND req = 1 THEN *)
    IF16_3 : BOOL; (* ELSIF remoteSel AND req = 2 THEN *)
    IF16_ELSE : BOOL; (* ELSE (none of: NOT gcb / remoteSel AND req = 1 / remoteSel AND req = 2) *)
    IF17 : BOOL; (* IF gcbRose AND latch THEN *)
    IF18 : BOOL; (* IF gcbFell AND latch THEN *)
    IF19 : BOOL; (* IF lastMw > 210.0 THEN *)
    IF20 : BOOL; (* IF PIC_HPB_MODE <> 0 THEN *)
    IF21 : BOOL; (* IF n > RPM * 1.03 THEN *)
    IF21_2 : BOOL; (* ELSIF n < RPM * 1.01 AND opcT <= 0.0 THEN *)
    IF22 : BOOL; (* IF flowing THEN *)
    IF22_ELSE : BOOL; (* ELSE (none of: flowing) *)
    IF23 : BOOL; (* IF hpMetal < 200.0 THEN *)
    IF23_2 : BOOL; (* ELSIF hpMetal < 350.0 THEN *)
    IF23_3 : BOOL; (* ELSIF hpMetal < 450.0 THEN *)
    IF23_ELSE : BOOL; (* ELSE (none of: hpMetal < 200.0 / hpMetal < 350.0 / hpMetal < 450.0) *)
    IF24 : BOOL; (* IF GO THEN *)
    IF25 : BOOL; (* IF dehMode = M_SPEED THEN *)
    IF25_ELSE : BOOL; (* ELSE (none of: dehMode = M_SPEED) *)
    IF26 : BOOL; (* IF HOLD THEN *)
    IF27 : BOOL; (* IF dehMode = M_SPEED THEN *)
    IF27_ELSE : BOOL; (* ELSE (none of: dehMode = M_SPEED) *)
    IF28 : BOOL; (* IF banded THEN *)
    IF29 : BOOL; (* IF NOT spdGo AND ABS(target - spdRef) > 1.0 THEN *)
    IF30 : BOOL; (* IF spdGo THEN *)
    IF31 : BOOL; (* IF ABS(target - spdRef) < 0.5 THEN *)
    IF32 : BOOL; (* IF IO_COMM_GEN AND SYNC_ACTIVE <> 0 AND spdRef >= RPM * 0.983 THEN *)
    IF33 : BOOL; (* IF df > 0.015 THEN *)
    IF33_2 : BOOL; (* ELSIF df < -0.015 THEN *)
    IF34 : BOOL; (* IF FREQ_ON <> 0 AND gcb THEN *)
    IF35 : BOOL; (* IF dehMode = M_REMOTE THEN *)
    IF35_2 : BOOL; (* ELSIF dehMode = M_LOAD THEN *)
    IF35_3 : BOOL; (* ELSIF dehMode <> M_PRESSURE THEN *)
    IF35_ELSE : BOOL; (* ELSE (none of: dehMode = M_REMOTE / dehMode = M_LOAD / dehMode <> M_PRESSURE) *)
    IF36 : BOOL; (* IF loadGo THEN *)
    IF37 : BOOL; (* IF ABS(tgt - loadRef) < 0.05 THEN *)
    IF38 : BOOL; (* IF tpl THEN *)
    IF39 : BOOL; (* IF NOT latch OR opc THEN *)
    IF39_2 : BOOL; (* ELSIF dehMode = M_SPEED THEN *)
    IF39_3 : BOOL; (* ELSIF dehMode = M_PRESSURE THEN *)
    IF39_ELSE : BOOL; (* ELSE (none of: NOT latch OR opc / dehMode = M_SPEED / dehMode = M_PRESSURE) *)
    IF40 : BOOL; (* IF latch AND NOT opc THEN *)
    IF40_ELSE : BOOL; (* ELSE (none of: latch AND NOT opc) *)
    IF41 : BOOL; (* IF latchFell AND PIC_HPB_MODE <> 0 THEN *)
    IF42 : BOOL; (* IF T_HPBCLOSED.Q AND HPB_MODE = 0 THEN *)
    IF43 : BOOL; (* IF follow THEN *)
    IF43_ELSE : BOOL; (* ELSE (none of: follow) *)
    IF44 : BOOL; (* IF tgt < hpbSp THEN *)
    IF44_ELSE : BOOL; (* ELSE (none of: tgt < hpbSp) *)
    IF45 : BOOL; (* IF tgt < lpbSp THEN *)
    IF45_ELSE : BOOL; (* ELSE (none of: tgt < lpbSp) *)
    IF46 : BOOL; (* IF PIC_LPB_MODE <> 0 AND NOT gcb THEN *)
    IF47 : BOOL; (* IF PIC_HPB_MODE <> 0 THEN *)
    IF47_ELSE : BOOL; (* ELSE (none of: PIC_HPB_MODE <> 0) *)
    IF48 : BOOL; (* IF PIC_LPB_MODE <> 0 THEN *)
  END_VAR

