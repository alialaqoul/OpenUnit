(* GEN - Generator, Excitation & Synchronising
   Generator protection with lockout relay 86G (first-out cause), field breaker (41) and
   generator breaker (52G), automatic synchroniser (speed matching via DEH, voltage matching
   via the AVR, advance-angle closing), AVR with MVAr / power-factor control and over / under
   excitation limiters, field forcing to no-load excitation on load rejection.
   Naming: I_* field inputs, Q_* field outputs, P_<PEER>_* peer status, W_<PEER>_* writes to
   a peer, IO_* bridge signals. *)
PROGRAM GEN_MAIN
  VAR
    (* Register map of GEN (generated by scripts/plc-build.js - do not edit here) *)
    HEARTBEAT AT %MD0 : DINT; (* Controller heartbeat counter - status *)
    SCAN_MS AT %MD1 : REAL; (* Logic execution time [ms] - status *)
    SIM_DT AT %MD2 : REAL; (* Simulation time step of last scan [s] - status *)
    IC_APPLIED AT %MD3 : DINT; (* Last applied initial condition - status *)
    SCAN_COUNT AT %MD4 : UDINT; (* Scan counter - status *)
    HEALTHY AT %QX0.0 : BOOL; (* Controller healthy - status *)
    COMM_PLANT AT %QX0.1 : BOOL; (* Communication with field I/O - status *)
    COMM_DEH AT %QX0.2 : BOOL; (* Communication with DEH - status *)
    FCB_OPEN AT %QX0.3 : BOOL; (* Field circuit breaker (41) - open/close command - operator *)
    FCB_CLOSE AT %QX0.4 : BOOL; (* Field circuit breaker (41) - close/open command - operator *)
    FCB_MODE AT %MD5 : DINT; (* Field circuit breaker (41) - mode - operator *)
    FCB_OPENED AT %QX0.5 : BOOL; (* Field circuit breaker (41) - open - status *)
    FCB_CLOSED AT %QX0.6 : BOOL; (* Field circuit breaker (41) - closed - status *)
    FCB_PERM AT %QX0.7 : BOOL; (* Field circuit breaker (41) - permissive - status *)
    FCB_ILK AT %QX1.0 : BOOL; (* Field circuit breaker (41) - interlock active - status *)
    GCB_OPEN AT %QX1.1 : BOOL; (* Generator circuit breaker (52G) - open/close command - operator *)
    GCB_CLOSE AT %QX1.2 : BOOL; (* Generator circuit breaker (52G) - close/open command - operator *)
    GCB_MODE AT %MD6 : DINT; (* Generator circuit breaker (52G) - mode - operator *)
    GCB_OPENED AT %QX1.3 : BOOL; (* Generator circuit breaker (52G) - open - status *)
    GCB_CLOSED AT %QX1.4 : BOOL; (* Generator circuit breaker (52G) - closed - status *)
    GCB_PERM AT %QX1.5 : BOOL; (* Generator circuit breaker (52G) - permissive - status *)
    GCB_ILK AT %QX1.6 : BOOL; (* Generator circuit breaker (52G) - interlock active - status *)
    AVR_PV AT %MD7 : REAL; (* Automatic voltage regulator - process value [kV] - status *)
    AVR_SP AT %MD8 : REAL; (* Automatic voltage regulator - setpoint [kV] - operator *)
    AVR_OUT AT %MD9 : REAL; (* Automatic voltage regulator - output [pu] - operator *)
    AVR_MODE AT %MD10 : DINT; (* Automatic voltage regulator - mode - operator *)
    AVR_KP AT %MD11 : REAL; (* Automatic voltage regulator - proportional gain - operator *)
    AVR_TI AT %MD12 : REAL; (* Automatic voltage regulator - integral time [s] - operator *)
    AVR_TD AT %MD13 : REAL; (* Automatic voltage regulator - derivative time [s] - operator *)
    AVR_CSP AT %MD14 : REAL; (* Automatic voltage regulator - cascade/remote setpoint [kV] - status *)
    AVR_STS AT %MD15 : DINT; (* Automatic voltage regulator - status bits - status *)
    EXC_MODE AT %MD16 : DINT; (* Excitation control mode - operator *)
    MVAR_SP AT %MD17 : REAL; (* Reactive power setpoint [MVAr] - operator *)
    PF_SP AT %MD18 : REAL; (* Power factor setpoint - operator *)
    SYNC_ON AT %QX1.7 : BOOL; (* Auto synchroniser ON - operator *)
    SYNC_OFF AT %QX2.0 : BOOL; (* Auto synchroniser OFF - operator *)
    RESET_86 AT %QX2.1 : BOOL; (* Generator lockout relay reset - operator *)
    TRIP_86 AT %QX2.2 : BOOL; (* Manual generator trip - operator *)
    SYNC_STATE AT %MD19 : DINT; (* Auto synchroniser state - status *)
    SYNC_CHECK AT %QX2.3 : BOOL; (* Synchro-check relay (25) permissive - status *)
    LOCKOUT_86 AT %QX2.4 : BOOL; (* Generator lockout relay 86G operated - status *)
    TRIP_CAUSE AT %MD20 : DINT; (* Generator trip first-out - status *)
    V_PU AT %MD21 : REAL; (* Generator voltage [pu] - status *)
    GRID_V_PU AT %MD22 : REAL; (* Grid voltage referred to generator [pu] - status *)
    VHZ AT %MD23 : REAL; (* Volts per hertz [pu] - status *)
    DV_PCT AT %MD24 : REAL; (* Voltage difference generator - grid [%] - status *)
    OEL_ACTIVE AT %QX2.5 : BOOL; (* Over-excitation limiter active - status *)
    UEL_ACTIVE AT %QX2.6 : BOOL; (* Under-excitation limiter active - status *)
    REV_POWER AT %QX2.7 : BOOL; (* Reverse power detected - status *)
    IO_COMM_PLANT AT %QX3.0 : BOOL; (* Bridge: field I/O link healthy - bridge in *)
    IO_COMM_DEH AT %QX3.1 : BOOL; (* Bridge: DEH link and heartbeat healthy - bridge in *)
    IO_IC_SEQ AT %MD25 : DINT; (* Bridge: initial-condition command sequence - bridge in *)
    IO_IC_ID AT %MD26 : DINT; (* Bridge: initial condition number - bridge in *)
    IO_IC_SNAP AT %QX3.2 : BOOL; (* Bridge: controller values restored from a snapshot - bridge in *)
    I_FCB_CLOSED AT %QX3.3 : BOOL; (* Field input: Field circuit breaker (41) closed - bridge in *)
    I_FIELD_AMPS AT %MD27 : REAL; (* Field input: Field current [A] - bridge in *)
    I_GCB_CLOSED AT %QX3.4 : BOOL; (* Field input: Generator circuit breaker (52G) closed - bridge in *)
    I_GEN_DIFF_RELAY AT %QX3.5 : BOOL; (* Field input: Generator differential relay (87G) operated - bridge in *)
    I_GEN_KA AT %MD28 : REAL; (* Field input: Generator stator current [kA] - bridge in *)
    I_GEN_KV AT %MD29 : REAL; (* Field input: Generator terminal voltage [kV] - bridge in *)
    I_GEN_MVAR AT %MD30 : REAL; (* Field input: Generator reactive power [MVAr] - bridge in *)
    I_GEN_MW AT %MD31 : REAL; (* Field input: Generator active power [MW] - bridge in *)
    I_GRID_KV AT %MD32 : REAL; (* Field input: Grid (400 kV bus) voltage [kV] - bridge in *)
    I_OUT_OF_STEP AT %QX3.6 : BOOL; (* Field input: Generator pole slipping - bridge in *)
    I_SIM_TIME_MS AT %MD33 : UDINT; (* Field input: Simulation clock [ms] - bridge in *)
    I_SPEED_B AT %MD34 : REAL; (* Field input: Turbine speed probe B [rpm] - bridge in *)
    I_STATOR_TEMP AT %MD35 : REAL; (* Field input: Stator winding temperature [degC] - bridge in *)
    I_SYNC_PHASE AT %MD36 : REAL; (* Field input: Synchroscope phase angle generator vs grid [deg] - bridge in *)
    I_SYNC_SLIP AT %MD37 : REAL; (* Field input: Slip frequency generator - grid [Hz] - bridge in *)
    P_DEH_LATCHED AT %QX3.7 : BOOL; (* From DEH: Turbine latched (reset) - bridge in *)
    P_DEH_MODE AT %MD38 : DINT; (* From DEH: DEH operating mode - bridge in *)
    P_DEH_TRIPPED AT %QX4.0 : BOOL; (* From DEH: Turbine tripped - bridge in *)
    IC_ACK AT %MD39 : DINT; (* Last initial-condition command acknowledged - status *)
    Q_EXC_DMD AT %MD40 : REAL; (* Field output: Field current demand [pu] - status *)
    Q_FCB_CMD AT %QX4.1 : BOOL; (* Field output: Field breaker close - status *)
    Q_GCB_CMD AT %QX4.2 : BOOL; (* Field output: Generator breaker close - status *)
    W_DEH_SYNC_ACTIVE AT %MD41 : DINT; (* To DEH: Auto synchroniser active - status *)
    W_DEH_SYNC_ADJ AT %MD42 : REAL; (* To DEH: Synchroniser speed adjust [rpm/s] - status *)
  END_VAR
  VAR
    RT : FB_PLC_RUNTIME;
    FCB : FB_ONOFF;
    GCB : FB_ONOFF;
    AVR : FB_LOOP;
    T_OOS : FB_TONS;           (* loss of field / pole slip *)
    T_REVP : FB_TONS;          (* reverse power *)
    T_OV : FB_TONS;            (* overvoltage *)
    T_FREQ : FB_TONS;          (* over / under frequency *)
    T_VHZ : FB_TONS;           (* over-excitation V/Hz *)
    T_OC : FB_TONS;            (* overcurrent *)
    T_LFP : FB_TONS;           (* low forward power after turbine trip *)
    dts : REAL;
    init : BOOL;
    speed : REAL;
    freq : REAL;
    vPu : REAL;
    gPu : REAL;
    vhzV : REAL;
    gcbIn : BOOL;
    fcbIn : BOOL;
    mw : REAL;
    slip : REAL;
    phase : REAL;
    ifPu : REAL;
    dV : REAL;
    dehOk : BOOL;
    dehLatched : BOOL;
    dehTripped : BOOL;
    dehSpeedMode : BOOL;
    c : ARRAY[1..10] OF BOOL;  (* protection functions, by trip cause number *)
    firstOut : DINT;
    lock : BOOL;
    cause : DINT;
    faultActive : BOOL;
    syncCheck : BOOL;
    syncPerm : BOOL;
    sync : DINT;               (* 0 OFF, 1 WAIT, 2 MATCH, 3 CLOSING, 4 DONE *)
    syncT : REAL;
    autoClose : BOOL;
    adj : REAL;
    vTarget : REAL;
    advance : REAL;
    qTarget : REAL;
    qErr : REAL;
    oel : BOOL;
    uel : BOOL;
    gcbPrev : BOOL;
    gcbOpened : BOOL;
    excHi : REAL;
    excLo : REAL;
  END_VAR
  VAR CONSTANT
    SLIP_TARGET : REAL := 0.08;   (* Hz, generator slightly faster than the grid *)
    RATED_KA : REAL := 21.6;       (* kA *)
  END_VAR
  VAR
    (* branch conditions of the function block diagram *)
    IF3 : BOOL; (* IF I_FCB_CLOSED THEN *)
    IF3_ELSE : BOOL; (* ELSE (none of: I_FCB_CLOSED) *)
    IF5 : BOOL; (* IF dehOk THEN *)
    IF5_ELSE : BOOL; (* ELSE (none of: dehOk) *)
    IF6 : BOOL; (* IF dehTripped THEN *)
    IF6_ELSE : BOOL; (* ELSE (none of: dehTripped) *)
    IF7 : BOOL; (* IF NOT lock AND firstOut > 0 THEN *)
    IF8 : BOOL; (* IF RESET_86 THEN *)
    IF9 : BOOL; (* IF lock AND NOT faultActive THEN *)
    IF10 : BOOL; (* IF SYNC_ON AND NOT gcbIn THEN *)
    IF11 : BOOL; (* IF SYNC_OFF THEN *)
    CASE12_1 : BOOL; (* CASE sync OF 1: *)
    CASE12_2 : BOOL; (* CASE sync OF 2: *)
    CASE12_3 : BOOL; (* CASE sync OF 3: *)
    CASE12_4 : BOOL; (* CASE sync OF 4: *)
    IF13 : BOOL; (* IF syncPerm THEN *)
    IF14 : BOOL; (* IF NOT syncPerm THEN *)
    IF14_ELSE : BOOL; (* ELSE (none of: NOT syncPerm) *)
    IF15 : BOOL; (* IF slip > 0.02 AND slip < 0.2 AND ABS(dV) < 2.0 AND phase < -advance + 4.0 AND phase > -advance - 6.0 THEN *)
    IF16 : BOOL; (* IF gcbIn THEN *)
    IF16_2 : BOOL; (* ELSIF syncT > 2.0 THEN *)
    IF17 : BOOL; (* IF syncT > 5.0 THEN *)
    IF18 : BOOL; (* IF gcbIn AND sync <> 4 AND sync <> 0 THEN *)
    IF19 : BOOL; (* IF sync = 2 OR sync = 3 THEN *)
    IF19_ELSE : BOOL; (* ELSE (none of: sync = 2 OR sync = 3) *)
    IF20 : BOOL; (* IF gcbIn AND AVR_MODE <> 0 AND EXC_MODE > 0 THEN *)
    IF21 : BOOL; (* IF EXC_MODE = 1 THEN *)
    IF21_ELSE : BOOL; (* ELSE (none of: EXC_MODE = 1) *)
    IF22 : BOOL; (* IF NOT gcbIn AND AVR_MODE <> 0 THEN *)
    IF23 : BOOL; (* IF gcbOpened AND AVR_MODE <> 0 THEN *)
    IF24 : BOOL; (* IF oel THEN *)
    IF24_ELSE : BOOL; (* ELSE (none of: oel) *)
    IF25 : BOOL; (* IF uel THEN *)
    IF25_ELSE : BOOL; (* ELSE (none of: uel) *)
  END_VAR

