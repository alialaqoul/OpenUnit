(* BMS - Burner Management System (NFPA 85 style)
   Master fuel trip (MFT) with first-out cause, furnace purge (5 min) with permissives, gas
   fuel train (main gas trip valves / vent: double block and bleed), four burner elevation
   light-off sequences (igniter -> main flame proving -> in service, flame failure trips the
   elevation), light-off time limit, watchdog to the hardwired MFT relay in the field.
   The four elevations A..D are processed in a FOR loop over arrays 1..4: their field I/O is
   copied in at the top and out at the bottom.
   Naming: I_* field inputs, Q_* field outputs, P_<PEER>_* peer status, IO_* bridge signals. *)
PROGRAM BMS_MAIN
  VAR
    (* Register map of BMS (generated by scripts/plc-build.js - do not edit here) *)
    HEARTBEAT AT %MD0 : DINT; (* Controller heartbeat counter - status *)
    SCAN_MS AT %MD1 : REAL; (* Logic execution time [ms] - status *)
    SIM_DT AT %MD2 : REAL; (* Simulation time step of last scan [s] - status *)
    IC_APPLIED AT %MD3 : DINT; (* Last applied initial condition - status *)
    SCAN_COUNT AT %MD4 : UDINT; (* Scan counter - status *)
    HEALTHY AT %QX0.0 : BOOL; (* Controller healthy - status *)
    COMM_PLANT AT %QX0.1 : BOOL; (* Communication with field I/O - status *)
    COMM_DEH AT %QX0.2 : BOOL; (* Communication with DEH - status *)
    MFT_PB AT %QX0.3 : BOOL; (* Manual MFT pushbutton - operator *)
    PURGE_START AT %QX0.4 : BOOL; (* Start furnace purge - operator *)
    MFT_RESET AT %QX0.5 : BOOL; (* MFT reset - operator *)
    MFT AT %QX0.6 : BOOL; (* Master fuel trip active - status *)
    MFT_CAUSE AT %MD5 : DINT; (* MFT first-out cause - status *)
    PURGE_READY AT %QX0.7 : BOOL; (* Purge permissives satisfied - status *)
    PURGE_ACTIVE AT %QX1.0 : BOOL; (* Purge in progress - status *)
    PURGE_COMPLETE AT %QX1.1 : BOOL; (* Purge complete - status *)
    PURGE_REMAIN AT %MD6 : REAL; (* Purge time remaining [s] - status *)
    LIGHTOFF_REMAIN AT %MD7 : REAL; (* Light-off time remaining [s] - status *)
    PP_FANS AT %QX1.2 : BOOL; (* Purge perm: ID and FD fan running - status *)
    PP_AIR AT %QX1.3 : BOOL; (* Purge perm: air flow 25 - 40 % - status *)
    PP_FUEL_OFF AT %QX1.4 : BOOL; (* Purge perm: gas trip valves & burner valves closed - status *)
    PP_FURN AT %QX1.5 : BOOL; (* Purge perm: furnace pressure normal - status *)
    PP_DRUM AT %QX1.6 : BOOL; (* Purge perm: drum level normal - status *)
    PP_NO_TRIP AT %QX1.7 : BOOL; (* Purge perm: no MFT condition present - status *)
    FUEL_IN_SERVICE AT %QX2.0 : BOOL; (* Fuel in service - status *)
    ELEV_INSERV AT %MD8 : DINT; (* Burner elevations in service - status *)
    FIREBALL AT %MD9 : REAL; (* Flame intensity (fireball scanner) [%] - status *)
    GAS_TRAIN_OPEN AT %QX2.1 : BOOL; (* Open main gas trip valves - operator *)
    GAS_TRAIN_CLOSE AT %QX2.2 : BOOL; (* Close main gas trip valves - operator *)
    GAS_TRAIN_STATE AT %MD10 : DINT; (* Gas fuel train state - status *)
    GAS_TRAIN_PERM AT %QX2.3 : BOOL; (* Gas train open permissive - status *)
    GAS_TRAIN_OPENED AT %QX2.4 : BOOL; (* Gas train open (SSVs open, vent closed) - status *)
    ELEV_A_START AT %QX2.5 : BOOL; (* Burner elevation A light-off sequence - operator *)
    ELEV_A_STOP AT %QX2.6 : BOOL; (* Burner elevation A shut-down sequence - operator *)
    ELEV_A_STATE AT %MD11 : DINT; (* Burner elevation A state - status *)
    ELEV_A_PERM AT %QX2.7 : BOOL; (* Burner elevation A light-off permissive - status *)
    ELEV_A_INSERV AT %QX3.0 : BOOL; (* Burner elevation A in service - status *)
    ELEV_A_FAIL AT %QX3.1 : BOOL; (* Burner elevation A flame failure - status *)
    ELEV_B_START AT %QX3.2 : BOOL; (* Burner elevation B light-off sequence - operator *)
    ELEV_B_STOP AT %QX3.3 : BOOL; (* Burner elevation B shut-down sequence - operator *)
    ELEV_B_STATE AT %MD12 : DINT; (* Burner elevation B state - status *)
    ELEV_B_PERM AT %QX3.4 : BOOL; (* Burner elevation B light-off permissive - status *)
    ELEV_B_INSERV AT %QX3.5 : BOOL; (* Burner elevation B in service - status *)
    ELEV_B_FAIL AT %QX3.6 : BOOL; (* Burner elevation B flame failure - status *)
    ELEV_C_START AT %QX3.7 : BOOL; (* Burner elevation C light-off sequence - operator *)
    ELEV_C_STOP AT %QX4.0 : BOOL; (* Burner elevation C shut-down sequence - operator *)
    ELEV_C_STATE AT %MD13 : DINT; (* Burner elevation C state - status *)
    ELEV_C_PERM AT %QX4.1 : BOOL; (* Burner elevation C light-off permissive - status *)
    ELEV_C_INSERV AT %QX4.2 : BOOL; (* Burner elevation C in service - status *)
    ELEV_C_FAIL AT %QX4.3 : BOOL; (* Burner elevation C flame failure - status *)
    ELEV_D_START AT %QX4.4 : BOOL; (* Burner elevation D light-off sequence - operator *)
    ELEV_D_STOP AT %QX4.5 : BOOL; (* Burner elevation D shut-down sequence - operator *)
    ELEV_D_STATE AT %MD14 : DINT; (* Burner elevation D state - status *)
    ELEV_D_PERM AT %QX4.6 : BOOL; (* Burner elevation D light-off permissive - status *)
    ELEV_D_INSERV AT %QX4.7 : BOOL; (* Burner elevation D in service - status *)
    ELEV_D_FAIL AT %QX5.0 : BOOL; (* Burner elevation D flame failure - status *)
    IO_COMM_PLANT AT %QX5.1 : BOOL; (* Bridge: field I/O link healthy - bridge in *)
    IO_COMM_DEH AT %QX5.2 : BOOL; (* Bridge: DEH link and heartbeat healthy - bridge in *)
    IO_IC_SEQ AT %MD15 : DINT; (* Bridge: initial-condition command sequence - bridge in *)
    IO_IC_ID AT %MD16 : DINT; (* Bridge: initial condition number - bridge in *)
    IO_IC_SNAP AT %QX5.3 : BOOL; (* Bridge: controller values restored from a snapshot - bridge in *)
    I_AIR_FLOW AT %MD17 : REAL; (* Field input: Total combustion air flow [t/h] - bridge in *)
    I_BFP_A_RUN AT %QX5.4 : BOOL; (* Field input: Boiler feed pump A running - bridge in *)
    I_BFP_B_RUN AT %QX5.5 : BOOL; (* Field input: Boiler feed pump B running - bridge in *)
    I_BFP_C_RUN AT %QX5.6 : BOOL; (* Field input: Boiler feed pump C running - bridge in *)
    I_BMS_WD_FAIL AT %QX5.7 : BOOL; (* Field input: BMS watchdog failure (hardwired MFT) - bridge in *)
    I_BRN_A_OPEN AT %QX6.0 : BOOL; (* Field input: Elevation A burner gas valves open - bridge in *)
    I_BRN_B_OPEN AT %QX6.1 : BOOL; (* Field input: Elevation B burner gas valves open - bridge in *)
    I_BRN_C_OPEN AT %QX6.2 : BOOL; (* Field input: Elevation C burner gas valves open - bridge in *)
    I_BRN_D_OPEN AT %QX6.3 : BOOL; (* Field input: Elevation D burner gas valves open - bridge in *)
    I_DRUM_LVL_A AT %MD18 : REAL; (* Field input: Drum level transmitter A [mm] - bridge in *)
    I_DRUM_LVL_B AT %MD19 : REAL; (* Field input: Drum level transmitter B [mm] - bridge in *)
    I_DRUM_LVL_C AT %MD20 : REAL; (* Field input: Drum level transmitter C [mm] - bridge in *)
    I_FD_A_RUN AT %QX6.4 : BOOL; (* Field input: FD fan A running - bridge in *)
    I_FD_B_RUN AT %QX6.5 : BOOL; (* Field input: FD fan B running - bridge in *)
    I_FLAME_A AT %QX6.6 : BOOL; (* Field input: Elevation A main flame detected - bridge in *)
    I_FLAME_B AT %QX6.7 : BOOL; (* Field input: Elevation B main flame detected - bridge in *)
    I_FLAME_C AT %QX7.0 : BOOL; (* Field input: Elevation C main flame detected - bridge in *)
    I_FLAME_D AT %QX7.1 : BOOL; (* Field input: Elevation D main flame detected - bridge in *)
    I_FUEL_HEAT AT %MD21 : REAL; (* Field input: Fuel heat input [MW] - bridge in *)
    I_FURN_PRESS_A AT %MD22 : REAL; (* Field input: Furnace pressure A [mbar] - bridge in *)
    I_FURN_PRESS_B AT %MD23 : REAL; (* Field input: Furnace pressure B [mbar] - bridge in *)
    I_FURN_PRESS_C AT %MD24 : REAL; (* Field input: Furnace pressure C [mbar] - bridge in *)
    I_GAS_HDR_PRESS AT %MD25 : REAL; (* Field input: Burner gas header pressure [mbar] - bridge in *)
    I_GAS_SUPPLY_PRESS AT %MD26 : REAL; (* Field input: Natural gas supply pressure (after PRS) [bar] - bridge in *)
    I_GAS_VENT_OPEN AT %QX7.2 : BOOL; (* Field input: Gas header vent (bleed) valve open - bridge in *)
    I_ID_A_RUN AT %QX7.3 : BOOL; (* Field input: ID fan A running - bridge in *)
    I_ID_B_RUN AT %QX7.4 : BOOL; (* Field input: ID fan B running - bridge in *)
    I_IGN_A_FLAME AT %QX7.5 : BOOL; (* Field input: Elevation A igniter flame proven - bridge in *)
    I_IGN_B_FLAME AT %QX7.6 : BOOL; (* Field input: Elevation B igniter flame proven - bridge in *)
    I_IGN_C_FLAME AT %QX7.7 : BOOL; (* Field input: Elevation C igniter flame proven - bridge in *)
    I_IGN_D_FLAME AT %QX8.0 : BOOL; (* Field input: Elevation D igniter flame proven - bridge in *)
    I_MGTV_CLOSED AT %QX8.1 : BOOL; (* Field input: Main gas trip valves closed - bridge in *)
    I_MGTV_OPEN AT %QX8.2 : BOOL; (* Field input: Main gas trip valves (SSV1+SSV2) open - bridge in *)
    I_SIM_TIME_MS AT %MD27 : UDINT; (* Field input: Simulation clock [ms] - bridge in *)
    P_DEH_TRIPPED AT %QX8.3 : BOOL; (* From DEH: Turbine tripped - bridge in *)
    IC_ACK AT %MD28 : DINT; (* Last initial-condition command acknowledged - status *)
    Q_BMS_WD AT %MD29 : DINT; (* Field output: BMS watchdog counter - status *)
    Q_BRN_A_CMD AT %QX8.4 : BOOL; (* Field output: Elevation A burner gas valves open - status *)
    Q_BRN_B_CMD AT %QX8.5 : BOOL; (* Field output: Elevation B burner gas valves open - status *)
    Q_BRN_C_CMD AT %QX8.6 : BOOL; (* Field output: Elevation C burner gas valves open - status *)
    Q_BRN_D_CMD AT %QX8.7 : BOOL; (* Field output: Elevation D burner gas valves open - status *)
    Q_GAS_VENT_CMD AT %QX9.0 : BOOL; (* Field output: Gas header vent valve open - status *)
    Q_IGN_A_CMD AT %QX9.1 : BOOL; (* Field output: Elevation A igniters on - status *)
    Q_IGN_B_CMD AT %QX9.2 : BOOL; (* Field output: Elevation B igniters on - status *)
    Q_IGN_C_CMD AT %QX9.3 : BOOL; (* Field output: Elevation C igniters on - status *)
    Q_IGN_D_CMD AT %QX9.4 : BOOL; (* Field output: Elevation D igniters on - status *)
    Q_MFT_TRIP AT %QX9.5 : BOOL; (* Field output: Master fuel trip relay (1 = tripped) - status *)
    Q_MGTV_CMD AT %QX9.6 : BOOL; (* Field output: Main gas trip valves open - status *)
  END_VAR
  VAR
    RT : FB_PLC_RUNTIME;
    T_AIRLOW : FB_TONS;
    T_LVLHH : FB_TONS;
    T_LVLLL : FB_TONS;
    T_FLAMELOSS : FB_TONS;
    T_FUELLOSS : FB_TONS;
    T_BFPLOSS : FB_TONS;
    T_HDRLL : FB_TONS;
    T_HDRHH : FB_TONS;
    T_SUPLOW : FB_TONS;
    dts : REAL;
    init : BOOL;
    (* process values *)
    idRun : BOOL;
    fdRun : BOOL;
    airPct : REAL;
    fp : REAL;
    lvl : REAL;
    hdr : REAL;
    sup : REAL;
    anyFlame : BOOL;
    anyBrnOpen : BOOL;
    nInService : DINT;
    bfpAny : BOOL;
    dehTripped : BOOL;
    dehTripPrev : BOOL;
    mgtvOpen : BOOL;
    (* MFT *)
    c : ARRAY[1..18] OF BOOL;   (* MFT conditions, by first-out cause number *)
    firstOut : DINT;
    mftOn : BOOL;
    cause : DINT;
    fuelWas : BOOL;
    lightoffT : REAL;
    lastFuel : REAL;
    (* purge *)
    ppFans : BOOL;
    ppAir : BOOL;
    ppFuelOff : BOOL;
    ppFurn : BOOL;
    ppDrum : BOOL;
    ppNoTrip : BOOL;
    ready : BOOL;
    purgeActive : BOOL;
    purgeT : REAL;
    purgeComplete : BOOL;
    (* gas train: 0 CLOSED, 1 OPENING, 2 OPEN, 3 TRIPPED *)
    trainState : DINT;
    trainT : REAL;
    trainPerm : BOOL;
    trainCmd : BOOL;
    trainOpen : BOOL;
    (* elevations: state 0 OFF, 1 STARTING, 2 IN SERVICE, 3 STOPPING, 4 FLAME FAIL *)
    x : INT;
    elevPerm : BOOL;
    eState : ARRAY[1..4] OF DINT;
    eT : ARRAY[1..4] OF REAL;
    eIgn : ARRAY[1..4] OF BOOL;
    eBrn : ARRAY[1..4] OF BOOL;
    eLossT : ARRAY[1..4] OF REAL;
    flame : ARRAY[1..4] OF BOOL;
    ignFlame : ARRAY[1..4] OF BOOL;
    brnOpen : ARRAY[1..4] OF BOOL;
    startPb : ARRAY[1..4] OF BOOL;
    stopPb : ARRAY[1..4] OF BOOL;
    fired : BOOL;
  END_VAR
  VAR CONSTANT
    AIR_MCR : REAL := 2247.0;       (* t/h *)
    PURGE_TIME : REAL := 300.0;     (* s *)
    LIGHTOFF_TIME : REAL := 900.0;  (* s *)
    S_OFF : DINT := 0;
    S_STARTING : DINT := 1;
    S_IN_SERVICE : DINT := 2;
    S_STOPPING : DINT := 3;
    S_FAIL : DINT := 4;
    TR_CLOSED : DINT := 0;
    TR_OPENING : DINT := 1;
    TR_OPEN : DINT := 2;
    TR_TRIPPED : DINT := 3;
  END_VAR
  VAR
    (* branch conditions of the function block diagram *)
    IF2 : BOOL; (* IF fired THEN *)
    IF2_ELSE : BOOL; (* ELSE (none of: fired) *)
    IF3 : BOOL; (* IF flame[1] THEN *)
    IF3_ELSE : BOOL; (* ELSE (none of: flame[1]) *)
    IF4 : BOOL; (* IF flame[2] THEN *)
    IF4_ELSE : BOOL; (* ELSE (none of: flame[2]) *)
    IF5 : BOOL; (* IF flame[3] THEN *)
    IF5_ELSE : BOOL; (* ELSE (none of: flame[3]) *)
    IF6 : BOOL; (* IF flame[4] THEN *)
    IF6_ELSE : BOOL; (* ELSE (none of: flame[4]) *)
    IF8 : BOOL; (* IF eState[1] = S_IN_SERVICE THEN *)
    IF9 : BOOL; (* IF eState[2] = S_IN_SERVICE THEN *)
    IF10 : BOOL; (* IF eState[3] = S_IN_SERVICE THEN *)
    IF11 : BOOL; (* IF eState[4] = S_IN_SERVICE THEN *)
    IF12 : BOOL; (* IF NOT mftOn THEN *)
    IF13 : BOOL; (* IF firstOut > 0 THEN *)
    IF14 : BOOL; (* IF PURGE_START AND ready AND NOT purgeComplete THEN *)
    IF15 : BOOL; (* IF purgeActive THEN *)
    IF16 : BOOL; (* IF NOT ready THEN *)
    IF16_ELSE : BOOL; (* ELSE (none of: NOT ready) *)
    IF17 : BOOL; (* IF purgeT >= PURGE_TIME THEN *)
    IF18 : BOOL; (* IF MFT_RESET AND mftOn AND purgeComplete AND ppNoTrip THEN *)
    IF19 : BOOL; (* IF GAS_TRAIN_OPEN AND trainPerm AND trainState = TR_CLOSED THEN *)
    IF20 : BOOL; (* IF GAS_TRAIN_CLOSE AND nInService = 0 THEN *)
    IF21 : BOOL; (* IF mftOn AND trainState <> TR_TRIPPED THEN *)
    IF22 : BOOL; (* IF trainState = TR_OPENING THEN *)
    IF23 : BOOL; (* IF mgtvOpen THEN *)
    IF23_2 : BOOL; (* ELSIF trainT > 10.0 THEN *)
    IF24 : BOOL; (* IF startPb[1] AND elevPerm AND eState[1] = S_OFF OR eState[1] = S_FAIL THEN *)
    IF25 : BOOL; (* IF stopPb[1] THEN *)
    IF26 : BOOL; (* IF eState[1] = S_STARTING OR eState[1] = S_IN_SERVICE THEN *)
    IF26_2 : BOOL; (* ELSIF eState[1] = S_FAIL THEN *)
    CASE27_1 : BOOL; (* CASE eState[1] OF 1: *)
    CASE27_2 : BOOL; (* CASE eState[1] OF 2: *)
    CASE27_3 : BOOL; (* CASE eState[1] OF 3: *)
    CASE27_ELSE : BOOL; (* CASE eState[1] OF ... ELSE *)
    IF28 : BOOL; (* IF eT[1] > 6.0 AND NOT ignFlame[1] THEN *)
    IF28_2 : BOOL; (* ELSIF ignFlame[1] THEN *)
    IF29 : BOOL; (* IF eState[1] = S_STARTING AND eBrn[1] AND flame[1] AND eT[1] > 5.0 THEN *)
    IF29_2 : BOOL; (* ELSIF eState[1] = S_STARTING AND eT[1] > 15.0 THEN *)
    IF30 : BOOL; (* IF NOT flame[1] THEN *)
    IF30_ELSE : BOOL; (* ELSE (none of: NOT flame[1]) *)
    IF31 : BOOL; (* IF NOT flame[1] AND eLossT[1] >= 2.0 THEN *)
    IF32 : BOOL; (* IF eT[1] > 3.0 THEN *)
    IF33 : BOOL; (* IF eState[1] <> S_IN_SERVICE THEN *)
    IF34 : BOOL; (* IF mftOn THEN *)
    IF35 : BOOL; (* IF eState[1] <> S_FAIL THEN *)
    IF36 : BOOL; (* IF startPb[2] AND elevPerm AND eState[2] = S_OFF OR eState[2] = S_FAIL THEN *)
    IF37 : BOOL; (* IF stopPb[2] THEN *)
    IF38 : BOOL; (* IF eState[2] = S_STARTING OR eState[2] = S_IN_SERVICE THEN *)
    IF38_2 : BOOL; (* ELSIF eState[2] = S_FAIL THEN *)
    CASE39_1 : BOOL; (* CASE eState[2] OF 1: *)
    CASE39_2 : BOOL; (* CASE eState[2] OF 2: *)
    CASE39_3 : BOOL; (* CASE eState[2] OF 3: *)
    CASE39_ELSE : BOOL; (* CASE eState[2] OF ... ELSE *)
    IF40 : BOOL; (* IF eT[2] > 6.0 AND NOT ignFlame[2] THEN *)
    IF40_2 : BOOL; (* ELSIF ignFlame[2] THEN *)
    IF41 : BOOL; (* IF eState[2] = S_STARTING AND eBrn[2] AND flame[2] AND eT[2] > 5.0 THEN *)
    IF41_2 : BOOL; (* ELSIF eState[2] = S_STARTING AND eT[2] > 15.0 THEN *)
    IF42 : BOOL; (* IF NOT flame[2] THEN *)
    IF42_ELSE : BOOL; (* ELSE (none of: NOT flame[2]) *)
    IF43 : BOOL; (* IF NOT flame[2] AND eLossT[2] >= 2.0 THEN *)
    IF44 : BOOL; (* IF eT[2] > 3.0 THEN *)
    IF45 : BOOL; (* IF eState[2] <> S_IN_SERVICE THEN *)
    IF46 : BOOL; (* IF mftOn THEN *)
    IF47 : BOOL; (* IF eState[2] <> S_FAIL THEN *)
    IF48 : BOOL; (* IF startPb[3] AND elevPerm AND eState[3] = S_OFF OR eState[3] = S_FAIL THEN *)
    IF49 : BOOL; (* IF stopPb[3] THEN *)
    IF50 : BOOL; (* IF eState[3] = S_STARTING OR eState[3] = S_IN_SERVICE THEN *)
    IF50_2 : BOOL; (* ELSIF eState[3] = S_FAIL THEN *)
    CASE51_1 : BOOL; (* CASE eState[3] OF 1: *)
    CASE51_2 : BOOL; (* CASE eState[3] OF 2: *)
    CASE51_3 : BOOL; (* CASE eState[3] OF 3: *)
    CASE51_ELSE : BOOL; (* CASE eState[3] OF ... ELSE *)
    IF52 : BOOL; (* IF eT[3] > 6.0 AND NOT ignFlame[3] THEN *)
    IF52_2 : BOOL; (* ELSIF ignFlame[3] THEN *)
    IF53 : BOOL; (* IF eState[3] = S_STARTING AND eBrn[3] AND flame[3] AND eT[3] > 5.0 THEN *)
    IF53_2 : BOOL; (* ELSIF eState[3] = S_STARTING AND eT[3] > 15.0 THEN *)
    IF54 : BOOL; (* IF NOT flame[3] THEN *)
    IF54_ELSE : BOOL; (* ELSE (none of: NOT flame[3]) *)
    IF55 : BOOL; (* IF NOT flame[3] AND eLossT[3] >= 2.0 THEN *)
    IF56 : BOOL; (* IF eT[3] > 3.0 THEN *)
    IF57 : BOOL; (* IF eState[3] <> S_IN_SERVICE THEN *)
    IF58 : BOOL; (* IF mftOn THEN *)
    IF59 : BOOL; (* IF eState[3] <> S_FAIL THEN *)
    IF60 : BOOL; (* IF startPb[4] AND elevPerm AND eState[4] = S_OFF OR eState[4] = S_FAIL THEN *)
    IF61 : BOOL; (* IF stopPb[4] THEN *)
    IF62 : BOOL; (* IF eState[4] = S_STARTING OR eState[4] = S_IN_SERVICE THEN *)
    IF62_2 : BOOL; (* ELSIF eState[4] = S_FAIL THEN *)
    CASE63_1 : BOOL; (* CASE eState[4] OF 1: *)
    CASE63_2 : BOOL; (* CASE eState[4] OF 2: *)
    CASE63_3 : BOOL; (* CASE eState[4] OF 3: *)
    CASE63_ELSE : BOOL; (* CASE eState[4] OF ... ELSE *)
    IF64 : BOOL; (* IF eT[4] > 6.0 AND NOT ignFlame[4] THEN *)
    IF64_2 : BOOL; (* ELSIF ignFlame[4] THEN *)
    IF65 : BOOL; (* IF eState[4] = S_STARTING AND eBrn[4] AND flame[4] AND eT[4] > 5.0 THEN *)
    IF65_2 : BOOL; (* ELSIF eState[4] = S_STARTING AND eT[4] > 15.0 THEN *)
    IF66 : BOOL; (* IF NOT flame[4] THEN *)
    IF66_ELSE : BOOL; (* ELSE (none of: NOT flame[4]) *)
    IF67 : BOOL; (* IF NOT flame[4] AND eLossT[4] >= 2.0 THEN *)
    IF68 : BOOL; (* IF eT[4] > 3.0 THEN *)
    IF69 : BOOL; (* IF eState[4] <> S_IN_SERVICE THEN *)
    IF70 : BOOL; (* IF mftOn THEN *)
    IF71 : BOOL; (* IF eState[4] <> S_FAIL THEN *)
    IF72 : BOOL; (* IF eState[1] = S_IN_SERVICE THEN *)
    IF73 : BOOL; (* IF eState[2] = S_IN_SERVICE THEN *)
    IF74 : BOOL; (* IF eState[3] = S_IN_SERVICE THEN *)
    IF75 : BOOL; (* IF eState[4] = S_IN_SERVICE THEN *)
    IF76 : BOOL; (* IF nInService > 0 THEN *)
    IF77 : BOOL; (* IF purgeComplete THEN *)
    IF77_ELSE : BOOL; (* ELSE (none of: purgeComplete) *)
    IF78 : BOOL; (* IF mftOn OR fuelWas THEN *)
    IF78_ELSE : BOOL; (* ELSE (none of: mftOn OR fuelWas) *)
    IF79 : BOOL; (* IF anyFlame THEN *)
    IF79_ELSE : BOOL; (* ELSE (none of: anyFlame) *)
  END_VAR

