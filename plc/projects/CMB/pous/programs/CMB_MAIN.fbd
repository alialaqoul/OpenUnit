(* CMB - Combustion & Draft Control
   Fuel master (gas flow -> gas control valve) on the CCS boiler demand with air/fuel
   cross-limiting and elevation capacity limit; total air flow (FD master) with O2 trim and
   minimum (purge) air; furnace pressure (ID master) with FD feed-forward and an MFT kicker;
   fan start permissives and interlocks; fuel runback kicker and fan runback request.
   Naming: I_* field inputs, Q_* field outputs, P_<PEER>_* peer status, IO_* bridge signals.
   BLR_DMD_REM / CCS_BM_AUTO / CCS_HB are written into this PLC by CCS. *)
PROGRAM CMB_MAIN
  VAR
    (* Register map of CMB (generated by scripts/plc-build.js - do not edit here) *)
    HEARTBEAT AT %MD0 : DINT; (* Controller heartbeat counter - status *)
    SCAN_MS AT %MD1 : REAL; (* Logic execution time [ms] - status *)
    SIM_DT AT %MD2 : REAL; (* Simulation time step of last scan [s] - status *)
    IC_APPLIED AT %MD3 : DINT; (* Last applied initial condition - status *)
    SCAN_COUNT AT %MD4 : UDINT; (* Scan counter - status *)
    HEALTHY AT %QX0.0 : BOOL; (* Controller healthy - status *)
    COMM_PLANT AT %QX0.1 : BOOL; (* Communication with field I/O - status *)
    COMM_BMS AT %QX0.2 : BOOL; (* Communication with BMS - status *)
    COMM_CCS AT %QX0.3 : BOOL; (* Communication with CCS - status *)
    APH_A_START AT %QX0.4 : BOOL; (* Air preheater A - start command - operator *)
    APH_A_STOP AT %QX0.5 : BOOL; (* Air preheater A - stop command - operator *)
    APH_A_MODE AT %MD5 : DINT; (* Air preheater A - mode - operator *)
    APH_A_RUN AT %QX0.6 : BOOL; (* Air preheater A - running - status *)
    APH_A_TRIP AT %QX0.7 : BOOL; (* Air preheater A - tripped - status *)
    APH_A_PERM AT %QX1.0 : BOOL; (* Air preheater A - start permissive - status *)
    APH_A_ILK AT %QX1.1 : BOOL; (* Air preheater A - protective interlock active - status *)
    APH_B_START AT %QX1.2 : BOOL; (* Air preheater B - start command - operator *)
    APH_B_STOP AT %QX1.3 : BOOL; (* Air preheater B - stop command - operator *)
    APH_B_MODE AT %MD6 : DINT; (* Air preheater B - mode - operator *)
    APH_B_RUN AT %QX1.4 : BOOL; (* Air preheater B - running - status *)
    APH_B_TRIP AT %QX1.5 : BOOL; (* Air preheater B - tripped - status *)
    APH_B_PERM AT %QX1.6 : BOOL; (* Air preheater B - start permissive - status *)
    APH_B_ILK AT %QX1.7 : BOOL; (* Air preheater B - protective interlock active - status *)
    ID_A_START AT %QX2.0 : BOOL; (* ID fan A - start command - operator *)
    ID_A_STOP AT %QX2.1 : BOOL; (* ID fan A - stop command - operator *)
    ID_A_MODE AT %MD7 : DINT; (* ID fan A - mode - operator *)
    ID_A_RUN AT %QX2.2 : BOOL; (* ID fan A - running - status *)
    ID_A_TRIP AT %QX2.3 : BOOL; (* ID fan A - tripped - status *)
    ID_A_PERM AT %QX2.4 : BOOL; (* ID fan A - start permissive - status *)
    ID_A_ILK AT %QX2.5 : BOOL; (* ID fan A - protective interlock active - status *)
    ID_B_START AT %QX2.6 : BOOL; (* ID fan B - start command - operator *)
    ID_B_STOP AT %QX2.7 : BOOL; (* ID fan B - stop command - operator *)
    ID_B_MODE AT %MD8 : DINT; (* ID fan B - mode - operator *)
    ID_B_RUN AT %QX3.0 : BOOL; (* ID fan B - running - status *)
    ID_B_TRIP AT %QX3.1 : BOOL; (* ID fan B - tripped - status *)
    ID_B_PERM AT %QX3.2 : BOOL; (* ID fan B - start permissive - status *)
    ID_B_ILK AT %QX3.3 : BOOL; (* ID fan B - protective interlock active - status *)
    FD_A_START AT %QX3.4 : BOOL; (* FD fan A - start command - operator *)
    FD_A_STOP AT %QX3.5 : BOOL; (* FD fan A - stop command - operator *)
    FD_A_MODE AT %MD9 : DINT; (* FD fan A - mode - operator *)
    FD_A_RUN AT %QX3.6 : BOOL; (* FD fan A - running - status *)
    FD_A_TRIP AT %QX3.7 : BOOL; (* FD fan A - tripped - status *)
    FD_A_PERM AT %QX4.0 : BOOL; (* FD fan A - start permissive - status *)
    FD_A_ILK AT %QX4.1 : BOOL; (* FD fan A - protective interlock active - status *)
    FD_B_START AT %QX4.2 : BOOL; (* FD fan B - start command - operator *)
    FD_B_STOP AT %QX4.3 : BOOL; (* FD fan B - stop command - operator *)
    FD_B_MODE AT %MD10 : DINT; (* FD fan B - mode - operator *)
    FD_B_RUN AT %QX4.4 : BOOL; (* FD fan B - running - status *)
    FD_B_TRIP AT %QX4.5 : BOOL; (* FD fan B - tripped - status *)
    FD_B_PERM AT %QX4.6 : BOOL; (* FD fan B - start permissive - status *)
    FD_B_ILK AT %QX4.7 : BOOL; (* FD fan B - protective interlock active - status *)
    FIC_GAS_PV AT %MD11 : REAL; (* Fuel master (natural gas flow -> gas control valve) - process value [t/h] - status *)
    FIC_GAS_SP AT %MD12 : REAL; (* Fuel master (natural gas flow -> gas control valve) - setpoint [t/h] - operator *)
    FIC_GAS_OUT AT %MD13 : REAL; (* Fuel master (natural gas flow -> gas control valve) - output [%] - operator *)
    FIC_GAS_MODE AT %MD14 : DINT; (* Fuel master (natural gas flow -> gas control valve) - mode - operator *)
    FIC_GAS_KP AT %MD15 : REAL; (* Fuel master (natural gas flow -> gas control valve) - proportional gain - operator *)
    FIC_GAS_TI AT %MD16 : REAL; (* Fuel master (natural gas flow -> gas control valve) - integral time [s] - operator *)
    FIC_GAS_TD AT %MD17 : REAL; (* Fuel master (natural gas flow -> gas control valve) - derivative time [s] - operator *)
    FIC_GAS_CSP AT %MD18 : REAL; (* Fuel master (natural gas flow -> gas control valve) - cascade/remote setpoint [t/h] - status *)
    FIC_GAS_STS AT %MD19 : DINT; (* Fuel master (natural gas flow -> gas control valve) - status bits - status *)
    FIC_AIR_PV AT %MD20 : REAL; (* Total air flow (FD master) - process value [t/h] - status *)
    FIC_AIR_SP AT %MD21 : REAL; (* Total air flow (FD master) - setpoint [t/h] - operator *)
    FIC_AIR_OUT AT %MD22 : REAL; (* Total air flow (FD master) - output [%] - operator *)
    FIC_AIR_MODE AT %MD23 : DINT; (* Total air flow (FD master) - mode - operator *)
    FIC_AIR_KP AT %MD24 : REAL; (* Total air flow (FD master) - proportional gain - operator *)
    FIC_AIR_TI AT %MD25 : REAL; (* Total air flow (FD master) - integral time [s] - operator *)
    FIC_AIR_TD AT %MD26 : REAL; (* Total air flow (FD master) - derivative time [s] - operator *)
    FIC_AIR_CSP AT %MD27 : REAL; (* Total air flow (FD master) - cascade/remote setpoint [t/h] - status *)
    FIC_AIR_STS AT %MD28 : DINT; (* Total air flow (FD master) - status bits - status *)
    SC_FDA_OUT AT %MD29 : REAL; (* FD fan A blade pitch - output [%] - operator *)
    SC_FDA_MODE AT %MD30 : DINT; (* FD fan A blade pitch - mode - operator *)
    SC_FDA_BIAS AT %MD31 : REAL; (* FD fan A blade pitch - bias [%] - operator *)
    SC_FDA_IN AT %MD32 : REAL; (* FD fan A blade pitch - auto demand [%] - status *)
    SC_FDA_FB AT %MD33 : REAL; (* FD fan A blade pitch - position feedback [%] - status *)
    SC_FDA_STS AT %MD34 : DINT; (* FD fan A blade pitch - status bits - status *)
    SC_FDB_OUT AT %MD35 : REAL; (* FD fan B blade pitch - output [%] - operator *)
    SC_FDB_MODE AT %MD36 : DINT; (* FD fan B blade pitch - mode - operator *)
    SC_FDB_BIAS AT %MD37 : REAL; (* FD fan B blade pitch - bias [%] - operator *)
    SC_FDB_IN AT %MD38 : REAL; (* FD fan B blade pitch - auto demand [%] - status *)
    SC_FDB_FB AT %MD39 : REAL; (* FD fan B blade pitch - position feedback [%] - status *)
    SC_FDB_STS AT %MD40 : DINT; (* FD fan B blade pitch - status bits - status *)
    AIC_O2_PV AT %MD41 : REAL; (* O2 trim - process value [%] - status *)
    AIC_O2_SP AT %MD42 : REAL; (* O2 trim - setpoint [%] - operator *)
    AIC_O2_OUT AT %MD43 : REAL; (* O2 trim - output [%] - operator *)
    AIC_O2_MODE AT %MD44 : DINT; (* O2 trim - mode - operator *)
    AIC_O2_KP AT %MD45 : REAL; (* O2 trim - proportional gain - operator *)
    AIC_O2_TI AT %MD46 : REAL; (* O2 trim - integral time [s] - operator *)
    AIC_O2_TD AT %MD47 : REAL; (* O2 trim - derivative time [s] - operator *)
    AIC_O2_CSP AT %MD48 : REAL; (* O2 trim - cascade/remote setpoint [%] - status *)
    AIC_O2_STS AT %MD49 : DINT; (* O2 trim - status bits - status *)
    PIC_FURN_PV AT %MD50 : REAL; (* Furnace pressure (ID master) - process value [mbar] - status *)
    PIC_FURN_SP AT %MD51 : REAL; (* Furnace pressure (ID master) - setpoint [mbar] - operator *)
    PIC_FURN_OUT AT %MD52 : REAL; (* Furnace pressure (ID master) - output [%] - operator *)
    PIC_FURN_MODE AT %MD53 : DINT; (* Furnace pressure (ID master) - mode - operator *)
    PIC_FURN_KP AT %MD54 : REAL; (* Furnace pressure (ID master) - proportional gain - operator *)
    PIC_FURN_TI AT %MD55 : REAL; (* Furnace pressure (ID master) - integral time [s] - operator *)
    PIC_FURN_TD AT %MD56 : REAL; (* Furnace pressure (ID master) - derivative time [s] - operator *)
    PIC_FURN_CSP AT %MD57 : REAL; (* Furnace pressure (ID master) - cascade/remote setpoint [mbar] - status *)
    PIC_FURN_STS AT %MD58 : DINT; (* Furnace pressure (ID master) - status bits - status *)
    SC_IDA_OUT AT %MD59 : REAL; (* ID fan A inlet vane - output [%] - operator *)
    SC_IDA_MODE AT %MD60 : DINT; (* ID fan A inlet vane - mode - operator *)
    SC_IDA_BIAS AT %MD61 : REAL; (* ID fan A inlet vane - bias [%] - operator *)
    SC_IDA_IN AT %MD62 : REAL; (* ID fan A inlet vane - auto demand [%] - status *)
    SC_IDA_FB AT %MD63 : REAL; (* ID fan A inlet vane - position feedback [%] - status *)
    SC_IDA_STS AT %MD64 : DINT; (* ID fan A inlet vane - status bits - status *)
    SC_IDB_OUT AT %MD65 : REAL; (* ID fan B inlet vane - output [%] - operator *)
    SC_IDB_MODE AT %MD66 : DINT; (* ID fan B inlet vane - mode - operator *)
    SC_IDB_BIAS AT %MD67 : REAL; (* ID fan B inlet vane - bias [%] - operator *)
    SC_IDB_IN AT %MD68 : REAL; (* ID fan B inlet vane - auto demand [%] - status *)
    SC_IDB_FB AT %MD69 : REAL; (* ID fan B inlet vane - position feedback [%] - status *)
    SC_IDB_STS AT %MD70 : DINT; (* ID fan B inlet vane - status bits - status *)
    PURGE_AIR AT %MD71 : REAL; (* Minimum (purge) air flow [t/h] - operator *)
    O2_BIAS AT %MD72 : REAL; (* O2 setpoint operator bias [%] - operator *)
    LIGHTOFF_POS AT %MD73 : REAL; (* Gas control valve light-off position [%] - operator *)
    MIN_FIRE_POS AT %MD74 : REAL; (* Gas control valve minimum-fire position [%] - operator *)
    BLR_DMD AT %MD75 : REAL; (* Boiler demand in use [%] - status *)
    GAS_DMD AT %MD76 : REAL; (* Gas flow demand (cross-limited) [t/h] - status *)
    GAS_CAPACITY AT %MD77 : REAL; (* Gas flow capacity of elevations in service [t/h] - status *)
    AIR_DMD AT %MD78 : REAL; (* Air flow demand (cross-limited) [t/h] - status *)
    FUEL_HEAT_EST AT %MD79 : REAL; (* Estimated firing rate [MW] - status *)
    FURN_PRESS_SEL AT %MD80 : REAL; (* Furnace pressure (median of 3) [mbar] - status *)
    O2_SP_PROG AT %MD81 : REAL; (* O2 setpoint program [%] - status *)
    FM_AUTO AT %QX5.0 : BOOL; (* Fuel master in automatic (CAS) - status *)
    AIR_AUTO AT %QX5.1 : BOOL; (* Air flow control in automatic - status *)
    FURN_AUTO AT %QX5.2 : BOOL; (* Furnace pressure control in automatic - status *)
    CROSS_LIMIT AT %QX5.3 : BOOL; (* Air/fuel cross limit active - status *)
    RB_FAN AT %QX5.4 : BOOL; (* Fan runback request - status *)
    CCS_HB AT %MD82 : DINT; (* CCS heartbeat (peer write) - written by CCS *)
    BLR_DMD_REM AT %MD83 : REAL; (* Boiler demand from CCS boiler master [%] - written by CCS *)
    CCS_BM_AUTO AT %MD84 : DINT; (* CCS boiler master in auto - written by CCS *)
    IO_COMM_PLANT AT %QX5.5 : BOOL; (* Bridge: field I/O link healthy - bridge in *)
    IO_COMM_BMS AT %QX5.6 : BOOL; (* Bridge: BMS link and heartbeat healthy - bridge in *)
    IO_COMM_CCS AT %QX5.7 : BOOL; (* Bridge: CCS link and heartbeat healthy - bridge in *)
    IO_IC_SEQ AT %MD85 : DINT; (* Bridge: initial-condition command sequence - bridge in *)
    IO_IC_ID AT %MD86 : DINT; (* Bridge: initial condition number - bridge in *)
    IO_IC_SNAP AT %QX6.0 : BOOL; (* Bridge: controller values restored from a snapshot - bridge in *)
    I_AIR_FLOW AT %MD87 : REAL; (* Field input: Total combustion air flow [t/h] - bridge in *)
    I_APH_A_RUN AT %QX6.1 : BOOL; (* Field input: Air preheater A running - bridge in *)
    I_APH_A_TRIP AT %QX6.2 : BOOL; (* Field input: Air preheater A tripped - bridge in *)
    I_APH_B_RUN AT %QX6.3 : BOOL; (* Field input: Air preheater B running - bridge in *)
    I_APH_B_TRIP AT %QX6.4 : BOOL; (* Field input: Air preheater B tripped - bridge in *)
    I_FD_A_PITCH_FB AT %MD88 : REAL; (* Field input: FD fan A blade pitch [%] - bridge in *)
    I_FD_A_RUN AT %QX6.5 : BOOL; (* Field input: FD fan A running - bridge in *)
    I_FD_A_TRIP AT %QX6.6 : BOOL; (* Field input: FD fan A tripped - bridge in *)
    I_FD_B_PITCH_FB AT %MD89 : REAL; (* Field input: FD fan B blade pitch [%] - bridge in *)
    I_FD_B_RUN AT %QX6.7 : BOOL; (* Field input: FD fan B running - bridge in *)
    I_FD_B_TRIP AT %QX7.0 : BOOL; (* Field input: FD fan B tripped - bridge in *)
    I_FUEL_HEAT AT %MD90 : REAL; (* Field input: Fuel heat input [MW] - bridge in *)
    I_FURN_PRESS_A AT %MD91 : REAL; (* Field input: Furnace pressure A [mbar] - bridge in *)
    I_FURN_PRESS_B AT %MD92 : REAL; (* Field input: Furnace pressure B [mbar] - bridge in *)
    I_FURN_PRESS_C AT %MD93 : REAL; (* Field input: Furnace pressure C [mbar] - bridge in *)
    I_GAS_FLOW AT %MD94 : REAL; (* Field input: Total natural gas flow [t/h] - bridge in *)
    I_GAS_HDR_PRESS AT %MD95 : REAL; (* Field input: Burner gas header pressure [mbar] - bridge in *)
    I_GCB_CLOSED AT %QX7.1 : BOOL; (* Field input: Generator circuit breaker (52G) closed - bridge in *)
    I_GFCV_FB AT %MD96 : REAL; (* Field input: Gas flow control valve position [%] - bridge in *)
    I_ID_A_RUN AT %QX7.2 : BOOL; (* Field input: ID fan A running - bridge in *)
    I_ID_A_TRIP AT %QX7.3 : BOOL; (* Field input: ID fan A tripped - bridge in *)
    I_ID_A_VANE_FB AT %MD97 : REAL; (* Field input: ID fan A inlet vane [%] - bridge in *)
    I_ID_B_RUN AT %QX7.4 : BOOL; (* Field input: ID fan B running - bridge in *)
    I_ID_B_TRIP AT %QX7.5 : BOOL; (* Field input: ID fan B tripped - bridge in *)
    I_ID_B_VANE_FB AT %MD98 : REAL; (* Field input: ID fan B inlet vane [%] - bridge in *)
    I_O2 AT %MD99 : REAL; (* Field input: Flue gas O2 (economizer outlet) [%] - bridge in *)
    I_SIM_TIME_MS AT %MD100 : UDINT; (* Field input: Simulation clock [ms] - bridge in *)
    I_STEAM_FLOW AT %MD101 : REAL; (* Field input: Main steam flow [t/h] - bridge in *)
    P_BMS_ELEV_INSERV AT %MD102 : DINT; (* From BMS: Burner elevations in service - bridge in *)
    P_BMS_GAS_TRAIN_OPENED AT %QX7.6 : BOOL; (* From BMS: Gas train open (SSVs open, vent closed) - bridge in *)
    P_BMS_MFT AT %QX7.7 : BOOL; (* From BMS: Master fuel trip active - bridge in *)
    IC_ACK AT %MD103 : DINT; (* Last initial-condition command acknowledged - status *)
    Q_APH_A_CMD AT %QX8.0 : BOOL; (* Field output: APH_A run command - status *)
    Q_APH_B_CMD AT %QX8.1 : BOOL; (* Field output: APH_B run command - status *)
    Q_FD_A_CMD AT %QX8.2 : BOOL; (* Field output: FD_A run command - status *)
    Q_FD_A_PITCH_DMD AT %MD104 : REAL; (* Field output: FD fan A pitch demand [%] - status *)
    Q_FD_B_CMD AT %QX8.3 : BOOL; (* Field output: FD_B run command - status *)
    Q_FD_B_PITCH_DMD AT %MD105 : REAL; (* Field output: FD fan B pitch demand [%] - status *)
    Q_GFCV_DMD AT %MD106 : REAL; (* Field output: Gas flow control valve demand [%] - status *)
    Q_ID_A_CMD AT %QX8.4 : BOOL; (* Field output: ID_A run command - status *)
    Q_ID_A_VANE_DMD AT %MD107 : REAL; (* Field output: ID fan A vane demand [%] - status *)
    Q_ID_B_CMD AT %QX8.5 : BOOL; (* Field output: ID_B run command - status *)
    Q_ID_B_VANE_DMD AT %MD108 : REAL; (* Field output: ID fan B vane demand [%] - status *)
  END_VAR
  VAR
    RT : FB_PLC_RUNTIME;
    APH_A : FB_MOTOR;
    APH_B : FB_MOTOR;
    ID_A : FB_MOTOR;
    ID_B : FB_MOTOR;
    FD_A : FB_MOTOR;
    FD_B : FB_MOTOR;
    FIC_GAS : FB_LOOP;
    FIC_AIR : FB_LOOP;
    AIC_O2 : FB_LOOP;
    PIC_FURN : FB_LOOP;
    SC_FDA : FB_STATION;
    SC_FDB : FB_STATION;
    SC_IDA : FB_STATION;
    SC_IDB : FB_STATION;
    T_KICK : FB_TONS;
    dts : REAL;
    init : BOOL;
    keep : BOOL;
    bmsOk : BOOL;
    mft : BOOL;
    elevIn : DINT;
    trainOpen : BOOL;
    aph : BOOL;
    idAny : BOOL;
    fdBoth : BOOL;
    idTripPrevA : BOOL;
    idTripPrevB : BOOL;
    blrLatch : REAL;
    blr : REAL;
    gasFlow : REAL;
    air : REAL;
    capacity : REAL;
    gasByAir : REAL;
    gasRaw : REAL;
    gasDmd : REAL;
    hdr : REAL;
    gfcv : REAL;
    fuelTrk : BOOL;
    fuelTrkVal : REAL;
    fansNow : DINT;
    fansPrev : DINT;
    steamPct : REAL;
    o2Prog : REAL;
    airCas : BOOL;
    airDmd : REAL;
    nFdRun : DINT;
    nFdAuto : DINT;
    fdAvg : REAL;
    fdMaster : REAL;
    fp : REAL;
    kicking : BOOL;
    nIdRun : DINT;
    nIdAuto : DINT;
    idAvg : REAL;
    fdRef : REAL;
    ffFurn : REAL;
    gasLo : REAL;
    gasHi : REAL;
  END_VAR
  VAR CONSTANT
    GAS_LHV : REAL := 49.0;       (* MJ/kg *)
    HEAT_MCR : REAL := 1620.0;       (* MW fuel heat at 100 % boiler demand *)
    GAS_MCR : REAL := 119.0204;   (* t/h at 100 % boiler demand = HEAT_MCR / GAS_LHV * 3.6 *)
    AIR_MCR : REAL := 2247.0;     (* t/h at 100 % boiler demand *)
    STOICH : REAL := 17.15;       (* kg air / kg gas *)
    ELEV_CAP : REAL := 39.3649;   (* t/h per burner elevation in service = 0.3 * GAS_MCR *)
    MCR_STEAM : REAL := 2149.0;
  END_VAR
  VAR
    (* branch conditions of the function block diagram *)
    IF3 : BOOL; (* IF I_FD_A_RUN THEN *)
    IF3_ELSE : BOOL; (* ELSE (none of: I_FD_A_RUN) *)
    IF4 : BOOL; (* IF I_FD_B_RUN THEN *)
    IF4_ELSE : BOOL; (* ELSE (none of: I_FD_B_RUN) *)
    IF5 : BOOL; (* IF I_ID_A_RUN THEN *)
    IF5_ELSE : BOOL; (* ELSE (none of: I_ID_A_RUN) *)
    IF6 : BOOL; (* IF I_ID_B_RUN THEN *)
    IF6_ELSE : BOOL; (* ELSE (none of: I_ID_B_RUN) *)
    IF7 : BOOL; (* IF IO_IC_ID >= 4 THEN *)
    IF7_ELSE : BOOL; (* ELSE (none of: IO_IC_ID >= 4) *)
    IF8 : BOOL; (* IF IO_IC_ID >= 2 THEN *)
    IF8_ELSE : BOOL; (* ELSE (none of: IO_IC_ID >= 2) *)
    IF10 : BOOL; (* IF bmsOk THEN *)
    IF10_ELSE : BOOL; (* ELSE (none of: bmsOk) *)
    IF11 : BOOL; (* IF IO_COMM_CCS THEN *)
    IF12 : BOOL; (* IF mft OR NOT trainOpen THEN *)
    IF12_2 : BOOL; (* ELSIF elevIn = 0 THEN *)
    IF13 : BOOL; (* IF I_FD_A_RUN THEN *)
    IF14 : BOOL; (* IF I_FD_B_RUN THEN *)
    IF15 : BOOL; (* IF I_ID_A_RUN THEN *)
    IF16 : BOOL; (* IF I_ID_B_RUN THEN *)
    IF17 : BOOL; (* IF fansPrev < 0 THEN *)
    IF18 : BOOL; (* IF fansNow < fansPrev AND gasFlow > 0.55 * GAS_MCR AND NOT fuelTrk THEN *)
    IF19 : BOOL; (* IF elevIn > 0 THEN *)
    IF19_ELSE : BOOL; (* ELSE (none of: elevIn > 0) *)
    IF20 : BOOL; (* IF hdr > 3600.0 THEN *)
    IF20_ELSE : BOOL; (* ELSE (none of: hdr > 3600.0) *)
    IF21 : BOOL; (* IF AIC_O2_MODE <> 0 THEN *)
    IF22 : BOOL; (* IF I_FD_A_RUN THEN *)
    IF23 : BOOL; (* IF SC_FDA_MODE = 1 THEN *)
    IF24 : BOOL; (* IF I_FD_B_RUN THEN *)
    IF25 : BOOL; (* IF SC_FDB_MODE = 1 THEN *)
    IF26 : BOOL; (* IF nFdRun > 0 THEN *)
    IF27 : BOOL; (* IF I_ID_A_RUN THEN *)
    IF28 : BOOL; (* IF SC_IDA_MODE = 1 THEN *)
    IF29 : BOOL; (* IF I_ID_B_RUN THEN *)
    IF30 : BOOL; (* IF SC_IDB_MODE = 1 THEN *)
    IF31 : BOOL; (* IF nIdRun > 0 THEN *)
    IF32 : BOOL; (* IF kicking THEN *)
    IF33 : BOOL; (* IF RT.RESYNC OR nIdAuto = 0 THEN *)
  END_VAR

